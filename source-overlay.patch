+              typeof value === 'bigint' ? value.toString() : value
+            )
+        }),
+        recipient: () => recipient
+      })
+    },
+    NoteArray: jest.fn((notes: unknown[]) => ({ notes })),
+    TransactionRequestBuilder: jest.fn(() => builder),
+    TransactionRequest: { deserialize: () => ({ expectedOutputOwnNotes: () => built.notes }) }
+  };
+});
+
+const row = (noteId: string): ITransaction => ({
+  id: 'review',
+  type: 'bridged-send',
+  accountId: 'sender',
+  amount: 100n,
+  faucetId: 'configured-usdcx',
