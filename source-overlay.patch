+describe('MidenClientProxy - capture-and-refuse offscreen settlement edges', () => {
+  type StrictRead = (account: string, request: Uint8Array, hold: WasmLockHold,
+    options?: { mode: 'capture-and-refuse'; assertLive: () => void }) => Promise<unknown>;
+  const strictOptions = (): { mode: 'capture-and-refuse'; assertLive: () => void } => ({
+    mode: 'capture-and-refuse', assertLive: () => undefined
+  });
+  function fixture() {
+    G.__px.signingInputsDeserialize.mockImplementation((bytes: Uint8Array) => ({
+      variantType: 0,
+      serialize: () => bytes.slice(),
+      transactionSummaryPayload: () => ({
+        accountDelta: () => ({ id: () => ({ toString: () => '0xaccount' }) }),
+        serialize: () => new Uint8Array([bytes[0] ?? 0]), free: jest.fn()
+      }),
+      free: jest.fn()
+    }));
+  }
+  const signing = (op: string, byte = 0x42): OffscreenSignRequest => ({
+    ...signRequestFor(op), signingInputsB64: Buffer.from([byte]).toString('base64')
+  });
+
+  it('refuses a callback between takeInFlight and adapter finally without capturing late inputs', async () => {
+    const { midenClientProxy, handleOffscreenSignRequest, __test } = await loadProxy(true);
+    fixture();
+    const read: StrictRead = midenClientProxy.dryRunTransaction;
+    const raw = jest.fn(async () => new Uint8Array([7]));
+    let late: Promise<unknown> = Promise.resolve();
+    fakeChrome.runtime.sendMessage.mockImplementation(async (env: { op_id: string }) => {
+      await handleOffscreenSignRequest(signing(env.op_id), raw);
+      return {
+        op_id: env.op_id, error: 'failed to generate signature',
+        get ok() {
+          // finishOp takes the entry before reading this property; the adapter's await has not resumed.
+          expect(__test.inFlightOpIds()).not.toContain(env.op_id);
+          late = handleOffscreenSignRequest(signing(env.op_id, 0x43), raw);
+          return false;
+        }
+      };
+    });
+    const pending = read('0xaccount', new Uint8Array([1]), G.__px.inlineHold, strictOptions()).catch(error => error);
+    await flush();
+    fireReady();
+    await pending;
+    await expect(late).resolves.toEqual(expect.objectContaining({ ok: false }));
+    expect(G.__px.signingInputsDeserialize).toHaveBeenCalledTimes(1);
+    expect(raw).not.toHaveBeenCalled();
+    expect(__test.inFlightSize()).toBe(0);
+    expect(__test.opSignCallbacksSize()).toBe(0);
+    expect(__test.opSignReasonsSize()).toBe(0);
+  });
+
+  it.each(['undefined', 'transport', 'wrong-op', 'missing-op', 'malformed-ok', 'missing-error', 'unrelated-error'])(
+    '%s terminal response cannot redeem valid side-channel data', async kind => {
+      const { midenClientProxy, handleOffscreenSignRequest, __test } = await loadProxy(true);
+      const { OperationAbortedError } = await import('./offscreen-codec');
+      fixture();
+      const read: StrictRead = midenClientProxy.dryRunTransaction;
+      const raw = jest.fn(async () => new Uint8Array([7]));
+      const transport = new Error('message port lost');
