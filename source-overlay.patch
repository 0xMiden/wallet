index 0000000000000000000000000000000000000000..d946633f0779fdcbd5453d2b9b17fb3350566867
--- /dev/null
+++ b/src/lib/agglayer/b2agg/request.ts
@@ -0,0 +1,96 @@
+import { NoteArray, NoteScript, NoteType, TransactionSummary } from '@miden-sdk/miden-sdk/lazy';
+
+import { splitExecutedOutputNotes } from 'lib/miden/activity/fee-notes';
+import {
+  accountRefToSdk,
+  feeAwareRequestBuilder,
+  getBech32AddressFromAccountId,
+  randomFeeSalt,
+  sameWalletAccountId
+} from 'lib/miden/sdk/helpers';
+import { assertWasmHoldCurrent, getMidenClient, type WasmLockHold } from 'lib/miden/sdk/miden-client';
+import type { AgglayerBridgeIntent } from 'lib/shared/types';
+import { b64ToU8 } from 'lib/shared/helpers';
+
+import { agglayerExitTxHash } from './exit-hash';
+import { createB2AggNote } from './note';
+
+export async function buildAgglayerBridgeRequest(
+  intent: AgglayerBridgeIntent,
+  midenBridge: string,
+  evmNetworkId: number,
+  expirationDelta: number,
+  hold: WasmLockHold,
+  assertLive: () => void
+) {
+  assertLive();
+  const note = createB2AggNote(
+    intent.amount,
+    intent.faucetId,
+    intent.destinationAddress,
+    intent.senderPublicKey,
+    midenBridge,
+    evmNetworkId
+  );
+  const noteId = note.id().toString().toLowerCase();
+  const exitTxHash = agglayerExitTxHash(note);
+  const client = await getMidenClient();
+  assertLive();
+  assertWasmHoldCurrent(hold, 'before the Agglayer fee-aware builder');
+  const builder = await feeAwareRequestBuilder(
+    client.client,
+    accountRefToSdk(intent.senderPublicKey).toString(),
+    randomFeeSalt()
+  );
+  assertLive();
+  assertWasmHoldCurrent(hold, 'after the Agglayer fee-aware builder');
+  const request = builder
+    .withOwnOutputNotes(new NoteArray([note]))
+    .withExpirationDelta(expirationDelta)
+    .build();
+  return {
+    noteId,
+    exitTxHash,
+    requestBytes: request.serialize(),
+    faucetBech32: getBech32AddressFromAccountId(accountRefToSdk(intent.faucetId))
+  };
+}
+
+/** Only the backend's exit and SDK fee-sponsorship outputs may become review authority. */
+export function assertAgglayerCapturedOutputs(
+  summaryBytes: string,
+  noteId: string,
+  sender: string,
+  nativeAsset: string
+): void {
+  const summary = TransactionSummary.deserialize(b64ToU8(summaryBytes));
+  const { userNotes } = splitExecutedOutputNotes(summary);
+  const sponsorRoot = NoteScript.feeSponsorship().root().toHex();
+  let exits = 0;
+  for (const output of userNotes) {
+    if (!sameWalletAccountId(output.metadata().sender().toString(), sender))
+      throw new Error('Agglayer output sender changed');
+    if (output.id().toString().toLowerCase() === noteId) {
+      if (output.metadata().noteType() !== NoteType.Public) throw new Error('Agglayer exit must be public');
+      exits++;
+      continue;
+    }
+    const note = output.intoFull();
+    const assets = note?.assets();
+    const fungible = assets?.fungibleAssets() ?? [];
+    const asset = fungible[0];
+    if (
+      !note ||
+      note.script().root().toHex() !== sponsorRoot ||
+      !sameWalletAccountId(note.metadata().sender().toString(), sender) ||
+      assets?.nonFungibleAssets().length !== 0 ||
+      fungible.length !== 1 ||
+      !asset ||
+      !sameWalletAccountId(asset.faucetId().toString(), nativeAsset) ||
+      asset.amount() <= 0n
+    ) {
+      throw new Error('Agglayer capture creates an unexpected output');
+    }
+  }
+  if (exits !== 1) throw new Error('Agglayer capture is missing its original exit note');
+}
