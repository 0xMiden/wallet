+async function readPrivate(dir: string, name: string): Promise<Buffer> {
+  const filename = path.join(dir, name);
+  const info = await lstat(filename);
+  requireSetup(info.isFile() && !info.isSymbolicLink() && (info.mode & 0o077) === 0, 'directory');
+  return readFile(filename);
+}
+async function validateBindings(): Promise<{ bindings: Bindings; digest: string }> {
+  const raw = await readFile(path.join(proposalRoot, 'source-bindings.json'));
+  const bindings = JSON.parse(raw.toString('utf8')) as Bindings;
+  requireSetup(bindings.schemaVersion === 1 && bindings.files.length === 7 &&
+    bindings.npm.package === '@miden-sdk/miden-sdk' && bindings.npm.version === '0.17.5', 'bindings');
+  for (const file of [...bindings.files, ...bindings.referenceFiles]) {
+    requireSetup(['proposal', 'repository'].includes(file.root) && !path.isAbsolute(file.path) &&
+      !file.path.split('/').includes('..') && file.mode === '100644' && hashPattern.test(file.sha256), 'bindings');
+    const filename = path.join(file.root === 'proposal' ? proposalRoot : repositoryRoot, file.path);
+    const info = await lstat(filename); const bytes = await readFile(filename);
+    const blob = createHash('sha1').update(`blob ${bytes.length}\0`).update(bytes).digest('hex');
+    requireSetup(info.isFile() && !info.isSymbolicLink() && (info.mode & 0o111) === 0 &&
+      bytes.length === file.bytes && sha256(bytes) === file.sha256 && blob === file.nativeGitBlob, 'bindings');
+  }
+  const pkg = JSON.parse(await readFile(path.join(repositoryRoot, 'node_modules/@miden-sdk/miden-sdk/package.json'), 'utf8'));
+  requireSetup(pkg.name === bindings.npm.package && pkg.version === bindings.npm.version, 'bindings');
+  return { bindings, digest: sha256(raw) };
+}
+async function observeNative(before: Set<string>, require: NodeRequire, bindings: Bindings, nativeModule: unknown): Promise<NativeIdentity> {
+  const loaded = Object.keys(require.cache).filter(name => name.endsWith('.node') && !before.has(name));
+  const sdkLoaded = loaded.filter(name => /[/\\]@miden-sdk[/\\]node-[^/\\]+[/\\]/.test(name));
+  requireSetup(sdkLoaded.length === 1, 'native');
+  const filename = await realpath(sdkLoaded[0]);
+  const match = filename.match(/^(.*[/\\]@miden-sdk[/\\](node-[^/\\]+))[/\\]/);
+  requireSetup(match, 'native');
+  const pkg = JSON.parse(await readFile(path.join(match[1], 'package.json'), 'utf8'));
+  const pinned = bindings.nativePackages.find(p => p.package === `@miden-sdk/${match[2]}`);
+  requireSetup(pinned && pkg.name === pinned.package && pkg.version === pinned.version, 'native');
+  // This is the already-loaded provider, never a second resolution/load for identification.
+  requireSetup(require.cache[sdkLoaded[0]]?.loaded && require.cache[sdkLoaded[0]]?.exports === nativeModule, 'native');
+  return { package: pinned.package, version: pinned.version, integrity: pinned.integrity,
+    addonSha256: sha256(await readFile(filename)) };
+}
+
+function normalizeAccount(sdk: Sdk, text: string): string {
+  return sdk.AccountId.fromHex(text).toString();
+}
+function normalizeWord(sdk: Sdk, text: string): string {
+  return sdk.Word.fromHex(text).toHex();
+}
+function normalizeNote(sdk: Sdk, text: string): string {
+  return sdk.NoteId.fromHex(text).toString();
+}
+function decodeCapture(sdk: Sdk, bytes: Uint8Array): { inputs: InstanceType<Sdk['SigningInputs']>; summary: InstanceType<Sdk['TransactionSummary']> } {
+  try {
+    const inputs = sdk.SigningInputs.deserialize(bytes);
+    requireSetup(inputs.variantType === sdk.SigningInputsType.TransactionSummary &&
+      Buffer.from(inputs.serialize()).equals(Buffer.from(bytes)), 'codec');
+    const summary = inputs.transactionSummaryPayload();
+    const serialized = summary.serialize();
+    requireSetup(Buffer.from(sdk.TransactionSummary.deserialize(serialized).serialize()).equals(Buffer.from(serialized)), 'codec');
+    return { inputs, summary };
+  } catch { throw new SetupError('codec'); }
+}
+function requireCodecRejection(sdk: Sdk, bytes: Uint8Array): void {
+  let refused = false;
+  try { decodeCapture(sdk, bytes); } catch (error) { refused = error instanceof SetupError && error.stage === 'codec'; }
+  requireSetup(refused, 'codec');
+}
+function verifyExposed(sdk: Sdk, phase: Phase, bytes: Uint8Array, summary: InstanceType<Sdk['TransactionSummary']>): void {
+  requireSetup(sha256(bytes) === phase.signingInputsSha256 &&
+    summary.accountDelta().id().toString() === normalizeAccount(sdk, phase.accountId) &&
+    summary.blockCommitment().toHex() === normalizeWord(sdk, phase.headerCommitment), 'codec');
+  const inputIds = summary.inputNotes().notes().map(n => n.id().toString());
+  const outputIds = summary.outputNotes().notes().map(n => n.id().toString());
+  requireSetup(same(inputIds, phase.inputNoteIds.map(id => normalizeNote(sdk, id))) &&
+    same(outputIds, phase.outputNoteIds.map(id => normalizeNote(sdk, id))), 'codec');
+  // These are initial-state producer assertions, not fields of the summary's changed account delta.
+  for (const key of ['publicKeyCommitment', 'accountCommitment', 'codeCommitment', 'vaultRoot'] as const)
+    requireSetup(normalizeWord(sdk, phase[key]) === phase[key], 'codec');
+}
+function verifyView(sdk: Sdk, wallet: Wallet, phase: Phase, view: TxAssetView, nativeAsset: string): string {
+  requireSetup(view.account && wallet.helpers.accountRefToSdk(view.account).toString() === normalizeAccount(sdk, phase.accountId), 'effects');
+  requireSetup(view.inputNotesConsumed === 0 && view.outputNotesCreated === 1 && view.unlistedAssets === 0 &&
+    !view.storageChanged && view.outgoingNfts.length === 0 && view.incomingNfts.length === 0 &&
+    view.viewConsumedNotes?.length === 0 && view.createdNotes?.length === 1 && !view.createdNotes[0].opaque, 'effects');
+  requireSetup(same(view.createdNotes.map(n => n.id), phase.userOutputNoteIds.map(id => normalizeNote(sdk, id))), 'effects');
+  const payment = view.createdNotes[0];
+  requireSetup(payment.nfts.length === 0 && payment.amounts.length === 1 && payment.amounts[0].amount === 100n &&
+    payment.amounts[0].faucetId === nativeAsset && view.outgoing.length === 1 &&
+    view.outgoing[0].faucetId === nativeAsset && view.outgoing[0].amount === 100n && view.incoming.length === 0 &&
+    view.fee && view.fee.faucetId === nativeAsset && view.fee.amount > 0n, 'effects');
+  return view.fee.amount.toString();
+}
+async function replayGuard(wallet: Wallet, row: ITransaction, phase: Phase, bytes: Uint8Array, view: TxAssetView,
+  onDelegate: () => void):
+  Promise<{ delegations: number; outcome: 'Delegated' | 'Refused' }> {
+  const expectedRefusal = wallet.guard.proposalEffectRefusal(row, view);
+  let delegations = 0;
+  const original = Buffer.from(bytes).toString('hex');
+  try {
+    await wallet.signer.withEffectCheckedSigner(row, async (publicKey, signingInputs) => {
+      delegations++; onDelegate();
+      requireSetup(publicKey === phase.publicKeyCommitment && signingInputs === original && expectedRefusal === undefined, 'trial');
+      return new Uint8Array([0]);
+    }, signer => signer(phase.publicKeyCommitment, original));
+    requireSetup(expectedRefusal === undefined && delegations === 1, 'trial');
+    return { delegations, outcome: 'Delegated' };
+  } catch (error) {
+    if (expectedRefusal !== undefined && delegations === 0 && error instanceof wallet.constants.ProposalEffectRefusedError &&
+      error.cause === undefined && error.message === `Refused to sign this execute transaction: ${expectedRefusal}`)
+      return { delegations, outcome: 'Refused' };
+    throw new SetupError('trial');
+  }
+}
+async function replayProbe(dir: string): Promise<ProbeResult> {
+  const started = performance.now();
+  let result = emptyResult(); let stage = 'directory';
+  try {
+    requireSetup(dir.length > 0 && process.env.MIDEN_MODULE_PATH === undefined, 'directory');
+    const directory = await lstat(dir);
