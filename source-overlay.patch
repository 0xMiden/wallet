@@ -0,0 +1,352 @@
+use std::fs::{self, OpenOptions};
+use std::io::Write;
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::Path;
+
+use anyhow::{ensure, Context};
+use miden_protocol::asset::{Asset, FungibleAsset};
+use miden_protocol::note::{Note, NoteType};
+use miden_protocol::testing::account_id::{ACCOUNT_ID_FEE_FAUCET, ACCOUNT_ID_PRIVATE_SENDER};
+use miden_protocol::transaction::RawOutputNote;
+use miden_protocol::utils::serde::{Deserializable, Serializable};
+use miden_protocol::Word;
+use miden_standards::account::auth::{commit_fee_conversion_info, FeeConversionInfo};
+use miden_standards::code_builder::CodeBuilder;
+use miden_standards::note::{P2idNote, TxFeeNote};
+use miden_testing::{Auth, MockChain, MockTransaction};
+use miden_tx::auth::SigningInputs;
+use miden_tx::TransactionExecutor;
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+
+use crate::capture::CaptureAuthenticator;
+
+const BASE_FEE: u32 = 500;
+const PRINCIPAL: u64 = 100;
+const WORK_ITERATIONS: u32 = 65_536;
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct ProbeMetadata {
+    schema_version: u32,
+    base_fee: u32,
+    principal: u64,
+    work_iterations: u32,
+    phases: [PhaseMetadata; 2],
+}
+
+#[derive(Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct PhaseMetadata {
+    capture_count: usize,
+    public_key_commitment: String,
+    signing_inputs_sha256: String,
+    account_id: String,
+    account_commitment: String,
+    nonce: String,
+    code_commitment: String,
+    vault_root: String,
+    input_note_ids: Vec<String>,
+    output_note_ids: Vec<String>,
+    user_output_note_ids: Vec<String>,
+    core_sha256: String,
+    header_number: u32,
+    header_commitment: String,
+}
+
+pub(crate) async fn capture_pair(out_dir: &Path) -> anyhow::Result<ProbeMetadata> {
+    let directory = fs::symlink_metadata(out_dir).context("output directory unavailable")?;
+    ensure!(directory.is_dir() && !directory.file_type().is_symlink(), "output is not a directory");
+    ensure!(directory.permissions().mode() & 0o077 == 0, "output directory is not private");
+    ensure!(fs::read_dir(out_dir)?.next().is_none(), "output directory must be empty");
+
+    let faucet = ACCOUNT_ID_FEE_FAUCET.try_into()?;
+    let funds: Asset = FungibleAsset::new(faucet, 1_000_000)?.into();
+    let mut builder = MockChain::builder().verification_base_fee(BASE_FEE);
+    let account = builder.add_existing_wallet_with_assets(Auth::basic_ecdsa(), [funds])?;
+    let mut chain = builder.build()?;
+    let initial_height = chain.latest_block_header().block_num().as_u32();
+    let payment_asset = FungibleAsset::new(faucet, PRINCIPAL)?;
+    let payment: Note = P2idNote::builder()
+        .sender(account.id())
+        .target(ACCOUNT_ID_PRIVATE_SENDER.try_into()?)
+        .serial_number(Word::from([1u32, 2, 3, 4]))
+        .note_type(NoteType::Private)
+        .asset(payment_asset)
+        .build()?.into();
+    let (auth_args, advice_value) = commit_fee_conversion_info(
+        FeeConversionInfo::one_to_one(faucet), Word::from([9u32, 10, 11, 12]),
+    );
+    let code_builder = CodeBuilder::default();
+    let source_manager = code_builder.source_manager();
+    let script = code_builder.compile_tx_script(payment_script(
+        initial_height, &payment, payment_asset,
+    ))?;
+    let first = chain.build_transaction(account.id())
+        .tx_script(script)
+        .auth_args(auth_args)
+        .add_advice_map_entry(auth_args, advice_value)
+        .expected_output_note(RawOutputNote::Full(payment.clone()))
+        .with_source_manager(source_manager.clone())
+        .build()?;
+    let args = first.tx_args().clone();
+    ensure!(first.account().to_bytes() == account.to_bytes(), "initial account mismatch");
+    let (s1, first_metadata) = capture_phase(&first).await?;
+
+    // The public mock seam uses a dummy proof; neither attempted transaction is applied.
+    chain.prove_next_block()?;
+    let mut second = chain.build_transaction(account.id())
+        .expected_output_note(RawOutputNote::Full(payment))
+        .with_source_manager(source_manager)
+        .build()?;
+    second.set_tx_args(args);
+    ensure!(second.account().to_bytes() == first.account().to_bytes(), "account changed");
+    ensure!(second.input_notes().to_bytes() == first.input_notes().to_bytes(), "inputs changed");
+    ensure!(second.tx_args().to_bytes() == first.tx_args().to_bytes(), "transaction args changed");
+    let (s2, second_metadata) = capture_phase(&second).await?;
+    validate_pair(&first_metadata, &second_metadata)?;
+    let metadata = ProbeMetadata {
+        schema_version: 1, base_fee: BASE_FEE, principal: PRINCIPAL,
+        work_iterations: WORK_ITERATIONS, phases: [first_metadata, second_metadata],
+    };
+    write_private(out_dir, "s1.bin", &s1)?;
+    write_private(out_dir, "s2.bin", &s2)?;
+    write_private(out_dir, "metadata.json", &serde_json::to_vec_pretty(&metadata)?)?;
+    Ok(metadata)
+}
+
+async fn capture_phase(tx: &MockTransaction) -> anyhow::Result<(Vec<u8>, PhaseMetadata)> {
+    ensure!(tx.input_notes().is_empty(), "unexpected input notes");
+    let inner = tx.authenticator().context("missing basic authenticator")?.clone();
+    ensure!(inner.keys().len() == 1, "expected one authentication key");
+    let expected_key = *inner.keys().keys().next().context("missing authentication key")?;
+    let recorder = CaptureAuthenticator::new(inner);
+    let header = tx.tx_inputs().block_header();
+    ensure!(header.fee_parameters().verification_base_fee() == BASE_FEE, "base fee changed");
+    let result = TransactionExecutor::new(tx)
+        .with_source_manager(tx.source_manager())
+        .with_authenticator(&recorder)
+        .execute_transaction(
+            tx.account().id(), header.block_num(), tx.input_notes().clone(), tx.tx_args().clone(),
+        )
+        .await;
+    ensure!(result.is_err(), "capture unexpectedly completed execution");
+    let public_key = recorder.captured_public_key_commitment().context("no signing callback")?;
+    let captures = recorder.take();
+    let capture_count = captures.len();
+    let captured = one_capture(captures)?;
+    ensure!(public_key == expected_key, "unexpected signing key");
+    let signing_inputs = SigningInputs::read_from_bytes(&captured)?;
+    ensure!(signing_inputs.to_bytes() == captured, "noncanonical signing inputs");
+    let SigningInputs::TransactionSummary(summary) = signing_inputs else {
+        anyhow::bail!("expected native transaction summary");
+    };
+    ensure!(summary.account_delta().id() == tx.account().id(), "summary account mismatch");
+    ensure!(summary.block_number() == header.block_num(), "summary height mismatch");
+    ensure!(summary.block_commitment() == header.commitment(), "summary header mismatch");
+    ensure!(summary.input_notes().to_bytes() == tx.input_notes().to_bytes(), "summary inputs mismatch");
+    let expected_ids = tx.expected_output_notes().iter().map(Note::id).collect::<Vec<_>>();
+    let user_ids = summary.output_notes().iter()
+        .filter(|note| note.metadata().tag() != TxFeeNote::TAG)
+        .map(RawOutputNote::id).collect::<Vec<_>>();
+    let fee_count = summary.output_notes().iter()
+        .filter(|note| note.metadata().tag() == TxFeeNote::TAG).count();
+    ensure!(expected_ids.len() == 1 && user_ids == expected_ids, "user output notes mismatch");
+    ensure!(fee_count == 1 && summary.output_notes().num_notes() == 2, "fee note count mismatch");
+    let account = tx.account();
+    let core_sha256 = request_core_digest(&[
+        &account.id().to_bytes(), &account.to_commitment().to_bytes(), &account.nonce().to_bytes(),
+        &account.code().commitment().to_bytes(), &account.vault().root().to_bytes(),
+        &tx.input_notes().to_bytes(), &tx.tx_args().to_bytes(), &expected_ids.to_bytes(),
+    ]);
+    let metadata = PhaseMetadata {
+        capture_count, public_key_commitment: public_key.to_string(),
+        signing_inputs_sha256: hex::encode(Sha256::digest(&captured)),
+        account_id: account.id().to_string(), account_commitment: account.to_commitment().to_string(),
+        nonce: account.nonce().to_string(), code_commitment: account.code().commitment().to_string(),
+        vault_root: account.vault().root().to_string(),
+        input_note_ids: summary.input_notes().iter().map(|note| note.id().to_string()).collect(),
+        output_note_ids: summary.output_notes().iter().map(|note| note.id().to_string()).collect(),
+        user_output_note_ids: user_ids.iter().map(ToString::to_string).collect(), core_sha256,
+        header_number: header.block_num().as_u32(), header_commitment: header.commitment().to_string(),
+    };
+    Ok((captured, metadata))
+}
+
+fn request_core_digest(parts: &[&[u8]]) -> String {
+    let mut hash = Sha256::new();
+    hash.update(b"O2/core/v1");
+    for part in parts {
+        hash.update((part.len() as u64).to_le_bytes());
+        hash.update(part);
+    }
+    hex::encode(hash.finalize())
+}
+
+fn one_capture(mut captures: Vec<Vec<u8>>) -> anyhow::Result<Vec<u8>> {
+    ensure!(captures.len() == 1, "expected exactly one signing callback");
+    Ok(captures.remove(0))
+}
+
+fn validate_pair(first: &PhaseMetadata, second: &PhaseMetadata) -> anyhow::Result<()> {
+    ensure!(first.capture_count == 1 && second.capture_count == 1, "capture count mismatch");
+    ensure!(first.public_key_commitment == second.public_key_commitment
+        && first.account_id == second.account_id
+        && first.account_commitment == second.account_commitment
+        && first.nonce == second.nonce && first.code_commitment == second.code_commitment
+        && first.vault_root == second.vault_root && first.input_note_ids == second.input_note_ids
+        && first.user_output_note_ids == second.user_output_note_ids
+        && first.core_sha256 == second.core_sha256, "request core changed");
+    ensure!(first.header_number.checked_add(1) == Some(second.header_number), "headers are not adjacent");
+    ensure!(first.header_commitment != second.header_commitment, "header did not change");
+    Ok(())
+}
+
+fn payment_script(initial_height: u32, payment: &Note, asset: FungibleAsset) -> String {
+    format!(r#"use miden::protocol::tx
+use miden::standards::note::note_creator
+use miden::standards::wallets::basic as basic_wallet
+
+@transaction_script
+pub proc main
+    exec.tx::get_reference_block_number
+    push.{initial_height} gt
+    if.true
+        push.{WORK_ITERATIONS}
+        dup neq.0
+        while.true
+            sub.1 dup neq.0
+        end
+        drop
+    end
+    push.0.0.0.0 push.0.0.0.0 push.0.0
+    push.{recipient}
+    push.{note_type} push.{tag}
+    call.note_creator::create_note
+    movdn.15 dropw dropw dropw drop drop drop
+    push.0.0.0.0 push.0.0.0 movup.7
+    push.{asset_value}
+    push.{asset_id}
+    call.basic_wallet::move_asset_to_note
+    dropw dropw dropw dropw
+end
+"#, recipient = payment.recipient().digest(), note_type = NoteType::Private as u8,
+        tag = payment.metadata().tag().as_u32(), asset_value = asset.to_value_word(),
+        asset_id = asset.to_id_word())
+}
+
+fn write_private(directory: &Path, name: &str, bytes: &[u8]) -> anyhow::Result<()> {
+    OpenOptions::new().write(true).create_new(true).mode(0o600)
+        .open(directory.join(name))?.write_all(bytes)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use miden_protocol::transaction::TransactionArgs;
+
+    #[test]
+    fn core_is_length_delimited_and_context_separate() {
+        assert_eq!(request_core_digest(&[]),
+            "5227be14a8823a70b48b4ccc0fa5ebae9a92bbe7d1a4135e327c9daf09568f07");
+        assert_ne!(request_core_digest(&[b"a", b"bc"]), request_core_digest(&[b"ab", b"c"]));
+        let args = TransactionArgs::default();
+        let changed_args = args.clone().with_auth_args(Word::from([1u32, 2, 3, 4]));
+        let mut parts = vec![
+            b"account-id".to_vec(), b"account-commitment".to_vec(), b"nonce".to_vec(),
+            b"code".to_vec(), b"vault".to_vec(), b"input-notes".to_vec(),
+            args.to_bytes(), b"payment-note-id".to_vec(),
+        ];
+        let digest = |parts: &[Vec<u8>]| {
+            request_core_digest(&parts.iter().map(Vec::as_slice).collect::<Vec<_>>())
+        };
+        let original = digest(&parts);
+        for index in 0..parts.len() {
+            let saved = parts[index].clone();
+            if index == 6 {
+                parts[index] = changed_args.to_bytes();
+            } else {
+                parts[index].push(1);
+            }
+            assert_ne!(original, digest(&parts));
+            parts[index] = saved;
+        }
+        let mut phase = synthetic_phase(original.clone());
+        phase.header_number += 1;
+        phase.header_commitment = "different-header".into();
+        assert_eq!(phase.core_sha256, digest(&parts));
+        assert_eq!(original, digest(&parts));
+    }
+
+    #[test]
+    fn capture_cardinality_is_one() {
+        assert!(one_capture(vec![]).is_err());
+        assert!(one_capture(vec![vec![1], vec![2]]).is_err());
+        assert!(one_capture(vec![vec![1]]).unwrap() == vec![1]);
+    }
+
+    #[test]
+    fn pair_rejects_changed_core_and_nonadjacent_context() {
+        let first = synthetic_phase("core".into());
+        let mut second = first.clone();
+        second.header_number = 1;
+        second.header_commitment = "next-header".into();
+        second.signing_inputs_sha256 = "next-signing-inputs-hash".into();
+        assert!(validate_pair(&first, &second).is_ok());
+        second.header_number = 2;
+        assert!(validate_pair(&first, &second).is_err());
+        second.header_number = 1;
+        second.core_sha256 = "changed-args-or-payment".into();
+        assert!(validate_pair(&first, &second).is_err());
+        second.core_sha256 = first.core_sha256.clone();
+        second.user_output_note_ids.clear();
+        assert!(validate_pair(&first, &second).is_err());
+        second.user_output_note_ids = first.user_output_note_ids.clone();
+        second.nonce = "2".into();
+        assert!(validate_pair(&first, &second).is_err());
+    }
+
+    #[test]
+    fn metadata_has_only_the_shared_wire_fields() {
+        let metadata = ProbeMetadata {
+            schema_version: 1, base_fee: BASE_FEE, principal: PRINCIPAL,
+            work_iterations: WORK_ITERATIONS,
+            phases: [synthetic_phase("core".into()), synthetic_phase("core".into())],
+        };
+        let value = serde_json::to_value(metadata).unwrap();
+        let object = value.as_object().unwrap();
+        assert_eq!(object.len(), 5);
+        assert_eq!(value["schemaVersion"], 1);
+        assert_eq!(value["baseFee"], 500);
+        assert_eq!(value["principal"], 100);
+        assert_eq!(value["workIterations"], 65536);
+        let phases = value["phases"].as_array().unwrap();
+        assert_eq!(phases.len(), 2);
+        for phase in phases {
+            assert_eq!(phase.as_object().unwrap().len(), 14);
+            for key in ["publicKeyCommitment", "signingInputsSha256", "accountId",
+                "accountCommitment", "nonce", "codeCommitment", "vaultRoot",
+                "coreSha256", "headerCommitment"] {
+                assert!(phase[key].is_string());
+            }
+            for key in ["inputNoteIds", "outputNoteIds", "userOutputNoteIds"] {
+                assert!(phase[key].as_array().unwrap().iter().all(|id| id.is_string()));
+            }
+            assert!(phase["captureCount"].is_u64());
+            assert!(phase["headerNumber"].is_u64());
+        }
+    }
+
+    fn synthetic_phase(core_sha256: String) -> PhaseMetadata {
+        PhaseMetadata {
+            capture_count: 1, public_key_commitment: "public-key-commitment".into(),
+            signing_inputs_sha256: "signing-inputs-hash".into(), account_id: "account-id".into(),
+            account_commitment: "account-commitment".into(), nonce: "1".into(),
+            code_commitment: "code".into(), vault_root: "vault".into(),
+            input_note_ids: vec![], output_note_ids: vec!["payment-note-id".into()],
+            user_output_note_ids: vec!["payment-note-id".into()], core_sha256,
+            header_number: 0, header_commitment: "header".into(),
+        }
+    }
+}
