+      controlDelegations: control.delegations, trialDelegations: trial.delegations, trialOutcome: trial.outcome,
+      s1Fee: fees[0], s2Fee: fees[1] }), sourceBindingsSha256: digest, native: result.native,
+      accountId: normalizeAccount(sdk, s1.accountId), inputNoteIds: views[0].viewConsumedNotes!.map(n => n.id),
+      userOutputNoteIds: views[0].createdNotes!.map(n => n.id), signingInputsSha256: bytes.map(sha256),
+      coreSha256: s1.coreSha256, evidenceOrigin: 'ProducerAssertedCore_CodecVerifiedExposedFields' };
