index 0000000000000000000000000000000000000000..87c17a7bbd83c6e6f546110ff6ef3166759c7d68
--- /dev/null
+++ b/qualification/o2-real-signing-inputs/rust/src/capture.rs
@@ -0,0 +1,90 @@
+use std::sync::{Arc, Mutex};
+
+use miden_processor::FutureMaybeSend;
+use miden_protocol::account::auth::{PublicKey, PublicKeyCommitment, Signature};
+use miden_protocol::utils::serde::Serializable;
+use miden_tx::auth::{BasicAuthenticator, SigningInputs, TransactionAuthenticator};
+use miden_tx::AuthenticationError;
+
+pub(crate) const CAPTURE_REFUSAL: &str = "O2_CAPTURE_ONLY";
+
+pub(crate) struct CaptureAuthenticator {
+    inner: BasicAuthenticator,
+    captures: Mutex<Vec<(PublicKeyCommitment, Vec<u8>)>>,
+}
+
+impl CaptureAuthenticator {
+    pub(crate) fn new(inner: BasicAuthenticator) -> Self {
+        Self { inner, captures: Mutex::new(Vec::new()) }
+    }
+
+    pub(crate) fn take(&self) -> Vec<Vec<u8>> {
+        std::mem::take(&mut *self.captures.lock().expect("capture lock poisoned"))
+            .into_iter().map(|(_, bytes)| bytes).collect()
+    }
+
+    pub(crate) fn captured_public_key_commitment(&self) -> Option<PublicKeyCommitment> {
+        self.captures.lock().expect("capture lock poisoned").first().map(|(key, _)| *key)
+    }
+}
+
+impl TransactionAuthenticator for CaptureAuthenticator {
+    fn get_signature(
+        &self,
+        pub_key_commitment: PublicKeyCommitment,
+        signing_inputs: &SigningInputs,
+    ) -> impl FutureMaybeSend<Result<Signature, AuthenticationError>> {
+        async move {
+            self.captures.lock().expect("capture lock poisoned")
+                .push((pub_key_commitment, signing_inputs.to_bytes()));
+            // Refusal is intentional: the VM's canonical inputs are the only product.
+            Err(AuthenticationError::RejectedSignature(CAPTURE_REFUSAL.into()))
+        }
+    }
+
+    fn get_public_key(
+        &self,
+        pub_key_commitment: PublicKeyCommitment,
+    ) -> impl FutureMaybeSend<Option<Arc<PublicKey>>> {
+        self.inner.get_public_key(pub_key_commitment)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use miden_protocol::Word;
+    use miden_testing::Auth;
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn capture_precedes_refusal() {
+        let (_, inner) = Auth::basic_ecdsa().build_components();
+        let inner = inner.unwrap();
+        let key = *inner.keys().keys().next().unwrap();
+        let recorder = CaptureAuthenticator::new(inner);
+        let original = SigningInputs::Blind(Word::from([1u32, 2, 3, 4]));
+
+        let auth_result = recorder.get_signature(key, &original).await;
+        let captured = recorder.take();
+        assert!(auth_result.is_err());
+        assert!(matches!(auth_result,
+            Err(AuthenticationError::RejectedSignature(reason)) if reason == CAPTURE_REFUSAL));
+        assert_eq!(captured.len(), 1);
+        assert!(captured[0] == original.to_bytes());
+        assert!(recorder.take().is_empty());
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn public_key_lookup_is_delegated() {
+        let (_, inner) = Auth::basic_ecdsa().build_components();
+        let inner = inner.unwrap();
+        let key = *inner.keys().keys().next().unwrap();
+        let expected = inner.get_public_key(key).await.unwrap();
+        let unknown = PublicKeyCommitment::from(Word::from([91u32, 92, 93, 94]));
+        let recorder = CaptureAuthenticator::new(inner);
+        let actual = recorder.get_public_key(key).await.unwrap();
+        assert!(Arc::ptr_eq(&actual, &expected));
+        assert!(recorder.get_public_key(unknown).await.is_none());
+        assert!(recorder.take().is_empty());
+    }
+}
