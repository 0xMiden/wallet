@@ -0,0 +1,433 @@
+import type { TxAssetView } from 'app/confirm/decode';
+import { midenClientProxy } from 'lib/miden/back/miden-client-proxy';
+import { approveCustomSimulation } from 'lib/miden/transaction/custom-effects';
+import { buildAgglayerBridgeRequest } from './request';
+import type { GuardianAccountProvider } from 'lib/miden/front/guardian-manager';
+
+import {
+  retireAgglayerBridgeReview,
+  cancelAgglayerBridgeReview,
+  clearAgglayerBridgeReviews,
+  getReviewedAgglayerBridge,
+  prepareAgglayerBridgeReview
+} from './review';
+
+let mockReviewSequence = 0;
+jest.mock('nanoid', () => ({ nanoid: () => `review-${++mockReviewSequence}` }));
+
+jest.mock('lib/miden/back/miden-client-proxy', () => ({
+  midenClientProxy: { dryRunTransaction: jest.fn() },
+  runsWasmInThisRealm: () => true
+}));
+jest.mock('lib/miden/sdk/helpers', () => ({
+  accountRefToSdk: (id: string) => ({
+    toString: () => id,
+    suffix: () => ({ asInt: () => 2n }),
+    prefix: () => ({ asInt: () => 3n })
+  }),
+  canonicalWalletAccountId: (id: string) => id,
+  sameWalletAccountId: (left: string, right: string) => left === right
+}));
+let mockScope = 'network-a';
+const mockHold = {};
+const mockAssertHold = jest.fn();
+jest.mock('lib/miden/sdk/miden-client', () => ({
+  withWasmClientLock: (callback: (hold: object) => Promise<unknown>) => callback(mockHold),
+  assertWasmHoldCurrent: () => mockAssertHold()
+}));
+jest.mock('lib/miden-chain/native-asset', () => ({
+  cacheScope: () => mockScope,
+  getNativeAssetId: async () => 'native',
+  refreshVerificationBaseFee: async () => 1,
+  isVerificationBaseFeeKnownAbsent: () => false
+}));
+let mockAvailable = true;
+let mockHeld = false;
+let mockRouteVersion = 0;
+const mockRoute = () => ({
+  midenBridge: 'bridge',
+  evmNetworkId: 0,
+  recovery: {
+    chainId: 1,
+    midenBridgeId: 'bridge',
+    contractAddress: '0x1111111111111111111111111111111111111111',
+    indexerUrl: `https://indexer.example/${mockRouteVersion}`,
+    rollupId: 7,
+    evmNetworkId: 0
+  }
+});
+jest.mock('lib/remote-config/runtime', () => ({
+  initBridgeConfig: jest.fn(async () => {}),
+  getBridgeConfigSnapshot: () => ({})
+}));
+jest.mock('lib/remote-config/availability', () => ({
+  featureAvailability: () => ({ state: mockAvailable ? 'available' : 'unavailable' })
+}));
+jest.mock('lib/remote-config/token-availability', () => ({ isNewTransferTokenHeld: () => mockHeld }));
+jest.mock('lib/remote-config/values', () => ({
+  getAgglayerBridgeOut: () => mockRoute(),
+  getAgglayerMidenBridge: () => mockRoute().midenBridge
+}));
+jest.mock('lib/miden-chain/constants', () => ({ ensureSdkWasmReady: async () => {} }));
+jest.mock('@miden-sdk/miden-sdk/lazy', () => ({
+  AccountId: { fromHex: (id: string) => id },
+  Endpoint: jest.fn(),
+  Word: jest.fn(() => ({ toHex: () => 'registry-key' })),
+  SlotAndKeys: jest.fn(),
+  AccountStorageRequirements: { fromSlotAndKeysArray: () => ({}) },
+  RpcClient: jest.fn(() => ({
+    getAccountProof: async () => ({
+      getStorageMapEntries: () => [
+        { key: () => ({ toHex: () => 'registry-key' }), value: () => ({ toU64s: () => [0n] }) }
+      ],
+      hasStorageMapTooManyEntries: () => false
+    })
+  }))
+}));
+jest.mock('lib/agglayer/allowed-faucets', () => ({ isAgglayerFaucetAllowed: jest.fn(async () => true) }));
+jest.mock('lib/miden/front/guardian-manager', () => ({ isGuardianAccount: jest.fn(async () => false) }));
+
+jest.mock('./request', () => ({
+  buildAgglayerBridgeRequest: jest.fn(async () => ({
+    noteId: 'burn',
+    exitTxHash: 'exit',
+    faucetBech32: 'native',
+    requestBytes: new Uint8Array([1, 2])
+  })),
+  assertAgglayerCapturedOutputs: jest.fn()
+}));
+jest.mock('lib/miden/transaction/custom-effects', () => ({ approveCustomSimulation: jest.fn() }));
+jest.mock('app/confirm/note-flow', () => ({ noteFlowFromSimulatedBytes: () => undefined }));
+
+const guardianProvider: GuardianAccountProvider = {
+  getAccounts: async () => [],
+  getPublicKeyForCommitment: async () => '',
+  signWord: async () => ''
+};
+const prepare = (intent_: typeof intent, live: () => void, preparationId = `page-${++mockReviewSequence}`) =>
+  prepareAgglayerBridgeReview(intent_, live, preparationId, guardianProvider);
+const intent = {
+  senderPublicKey: 'sender',
+  faucetId: 'native',
+  amount: 10_000_000n,
+  destinationAddress: '0x1111111111111111111111111111111111111111',
+  destinationChainId: 1
+};
+const view = (): TxAssetView => ({
+  account: 'sender',
+  outgoing: [{ faucetId: 'native', amount: 10_000_003n }],
+  incoming: [],
+  outgoingNfts: [],
+  incomingNfts: [],
+  unlistedAssets: 0,
+  inputNotesConsumed: 0,
+  outputNotesCreated: 2,
+  viewConsumedNotes: [],
+  storageChanged: false,
+  heldNotesSpent: 0,
+  fee: { faucetId: 'native', amount: 2n },
+  createdNotes: [
+    { id: 'burn', amounts: [{ faucetId: 'native', amount: 10_000_000n }], nfts: [] },
+    { id: 'sponsor', amounts: [{ faucetId: 'native', amount: 3n }], nfts: [] }
+  ]
+});
+function givenApproval(shown = view(), ids = ['burn', 'sponsor']) {
+  jest.mocked(approveCustomSimulation).mockReturnValue({
+    view: shown,
+    effects: {
+      shape: 'summary',
+      outgoing: shown.outgoing,
+      incoming: [],
+      outgoingNfts: [],
+      incomingNfts: [],
+      unlistedAssets: 0,
+      recipients: ['burn-recipient', 'sponsor-recipient'],
+      inputNotesConsumed: 0,
+      outputNotesCreated: 2,
+      storageChanged: false,
+      introducedNoteIds: [],
+      approvedOutputNoteIds: ids
+    },
+    signing: {
+      approvedOutflow: shown.outgoing,
+      approvedNftOutflow: [],
+      introducedNoteIds: [],
+      approvedOutputNoteIds: ids
+    },
+    spends: shown.outgoing
+  });
+}
+beforeEach(() => {
+  jest.clearAllMocks();
+  clearAgglayerBridgeReviews();
+  jest
+    .mocked(midenClientProxy.dryRunTransaction)
+    .mockResolvedValue({ signingInputsBytes: 'captured-inputs', summaryBytes: 'summary' });
+  givenApproval();
+  mockScope = 'network-a';
+  mockAvailable = true;
+  mockHeld = false;
+  mockRouteVersion = 0;
+});
+
+it('captures the real immutable B2AGG once under its original hold, with an principal and sponsorship displayed', async () => {
+  const live = jest.fn();
+  const review = await prepare(intent, live);
+  expect(buildAgglayerBridgeRequest).toHaveBeenCalledTimes(1);
+  expect(buildAgglayerBridgeRequest).toHaveBeenCalledWith(intent, 'bridge', 0, 600, mockHold, expect.any(Function));
+  expect(midenClientProxy.dryRunTransaction).toHaveBeenCalledWith('sender', new Uint8Array([1, 2]), mockHold, {
+    mode: 'capture-and-refuse',
+    assertLive: expect.any(Function)
+  });
+  expect(approveCustomSimulation).toHaveBeenCalledWith({ summaryBytes: 'summary', introducedNoteIds: [] });
+  expect(review.effects.view.outgoing).toEqual([{ faucetId: 'native', amount: '10000003' }]);
+  expect(review.effects.view.fee).toEqual({ faucetId: 'native', amount: '2' });
+  const record = getReviewedAgglayerBridge(review.id, intent);
+  expect(record.noteId).toBe('burn');
+  expect(record.approval.signing.approvedOutputNoteIds).toEqual(['burn', 'sponsor']);
+  expect(live).toHaveBeenCalled();
+  expect(mockAssertHold).toHaveBeenCalled();
+});
+
+it.each([
+  {},
+  { summaryBytes: 'summary' },
+  { executedBytes: 'executed' },
+  { signingInputsBytes: 'captured-inputs', summaryBytes: 'summary', executedBytes: 'executed' }
+])('never approves a missing or fallback capture: %p', async captured => {
+  jest.mocked(midenClientProxy.dryRunTransaction).mockResolvedValue(captured);
+  await expect(prepare(intent, () => {})).rejects.toThrow('did not capture');
+  expect(approveCustomSimulation).not.toHaveBeenCalled();
+  expect(() => getReviewedAgglayerBridge('forged', intent)).toThrow();
+});
+
+it.each<Partial<TxAssetView>>([
+  { account: 'other' },
+  { account: undefined },
+  { unlistedAssets: 1 },
+  { inputNotesConsumed: 1 },
+  { createdNotes: undefined },
+  { incoming: [{ faucetId: 'native', amount: 1n }] },
+  { outgoing: [{ faucetId: 'native', amount: 99_000_000n }] },
+  { createdNotes: [{ id: 'burn', amounts: [], nfts: [], opaque: true }] }
+])('refuses unreadable, unlisted, foreign or unexpected input effects: %p', async changed => {
+  givenApproval({ ...view(), ...changed });
+  await expect(prepare(intent, () => {})).rejects.toThrow('could not be verified');
+});
+
+it('refuses a capture missing the original B2AGG id, not merely the principal amount', async () => {
+  givenApproval(view(), ['replacement-burn', 'sponsor']);
+  await expect(prepare(intent, () => {})).rejects.toThrow('could not be verified');
+});
+
