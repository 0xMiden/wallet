+    const info = await handle.stat();
+    const entry = await lstat(filename);
+    requireSetup(info.isFile() && info.uid === process.getuid() && (info.mode & 0o7777) === 0o600 &&
+      info.nlink === 1 && info.size === 0 && entry.isFile() && !entry.isSymbolicLink() &&
+      entry.dev === info.dev && entry.ino === info.ino, 'directory');
