index 0000000000000000000000000000000000000000..72d7c1943a92916fccc26a8fc15f5fb1a7b71b41
--- /dev/null
+++ b/src/lib/usdcx/burn-review.ts
@@ -0,0 +1,170 @@
+import { nanoid } from 'nanoid';
+
+import { netOutflowByFaucet } from 'app/confirm/decode';
+import { noteFlowFromSimulatedBytes } from 'app/confirm/note-flow';
+import { toSimulatedEffectsWire } from 'app/confirm/simulated-wire';
+import { midenClientProxy, runsWasmInThisRealm } from 'lib/miden/back/miden-client-proxy';
+import type { IConsumedAssetTotal } from 'lib/miden/db/types';
+import { accountRefToSdk, canonicalWalletAccountId, sameWalletAccountId } from 'lib/miden/sdk/helpers';
+import { assertWasmHoldCurrent, withWasmClientLock } from 'lib/miden/sdk/miden-client';
+import { approveCustomSimulation, type ApprovedCustomSimulation } from 'lib/miden/transaction/custom-effects';
+import {
+  cacheScope,
+  getNativeAssetId,
+  isVerificationBaseFeeKnownAbsent,
+  refreshVerificationBaseFee
+} from 'lib/miden-chain/native-asset';
+import { initBridgeConfig } from 'lib/remote-config/runtime';
+import type { UsdcxBurnIntent, UsdcxBurnReview } from 'lib/shared/types';
+
+import { buildUsdcxBurnRequest, readUsdcxMinimumBurn } from './burn-request';
+import { getUsdcxDestination } from './constant';
+import { validateUsdcxWithdrawal } from './withdrawal';
+
+interface ReviewedBurn {
+  id: string;
+  intent: Readonly<UsdcxBurnIntent>;
+  destinationDomain: number;
+  burnNoteId: string;
+  requestBytes: Uint8Array;
+  approval: ApprovedCustomSimulation;
+  spends: IConsumedAssetTotal[];
+  assertLive: () => void;
+}
+
+// One pending review per account; another capture invalidates an older in-flight capture too.
+const REVIEW_LIFETIME_MS = 120_000; // Matches the wallet confirmation window, including capture time.
+const current = new Map<string, { id: string; preparationId: string }>();
+const reviewed = new Map<string, ReviewedBurn>();
+
+export function clearUsdcxBurnReviews(): void {
+  current.clear();
+  reviewed.clear();
+}
+
+export function cancelUsdcxBurnReview(senderPublicKey: string, preparationId: string): void {
+  const account = canonicalWalletAccountId(senderPublicKey);
+  if (current.get(account)?.preparationId !== preparationId) return;
+  current.delete(account);
+  reviewed.delete(account);
+}
+
+export function retireUsdcxBurnReview(senderPublicKey: string, id: string): void {
+  const account = canonicalWalletAccountId(senderPublicKey);
+  if (current.get(account)?.id !== id) return;
+  current.delete(account);
+  reviewed.delete(account);
+}
+
+/** Builds the original BURN once. Only this backend record, never a client effects object, can be redeemed. */
+export async function prepareUsdcxBurnReview(
+  intent: UsdcxBurnIntent,
+  assertSessionLive: () => void,
+  preparationId?: string
+): Promise<UsdcxBurnReview> {
+  const account = canonicalWalletAccountId(intent.senderPublicKey);
+  const id = nanoid();
+  const scope = cacheScope();
+  const expiresAt = Date.now() + REVIEW_LIFETIME_MS;
+  current.set(account, { id, preparationId: preparationId ?? id });
+  reviewed.delete(account);
+  const boundIntent = Object.freeze({ ...intent });
+  const assertLive = () => {
+    assertSessionLive();
+    if (current.get(account)?.id !== id || cacheScope() !== scope || Date.now() >= expiresAt) {
+      throw new Error('USDCx burn review is no longer current');
+    }
+  };
+  assertLive();
+  await initBridgeConfig();
+  assertLive();
+  await getNativeAssetId();
+  assertLive();
+  const minimum = await readUsdcxMinimumBurn();
+  assertLive();
+  validateUsdcxWithdrawal(boundIntent.faucetId, boundIntent.destinationChainId, boundIntent.amount, minimum);
+  const destinationDomain = getUsdcxDestination(boundIntent.destinationChainId).domain;
+  const fee = await refreshVerificationBaseFee();
+  assertLive();
+  if (fee === null && !isVerificationBaseFeeKnownAbsent()) throw new Error('USDCx burn fee is not known');
+  return withWasmClientLock(
+    async hold => {
+      const assertCaptureLive = () => {
+        assertWasmHoldCurrent(hold, 'during the original burn capture');
+        assertLive();
+      };
+      assertCaptureLive();
+      const built = buildUsdcxBurnRequest(
+        boundIntent.senderPublicKey,
+        boundIntent.amount,
+        boundIntent.destinationAddress,
+        destinationDomain
+      );
+      const captured = await midenClientProxy.dryRunTransaction(
+        accountRefToSdk(boundIntent.senderPublicKey).toString(),
+        built.requestBytes,
+        hold,
+        { mode: 'capture-and-refuse', assertLive: assertCaptureLive }
+      );
+      assertCaptureLive();
+      if (!captured.signingInputsBytes || !captured.summaryBytes || captured.executedBytes) {
+        throw new Error('USDCx burn did not capture signing inputs');
+      }
+      const approval = approveCustomSimulation({ summaryBytes: captured.summaryBytes, introducedNoteIds: [] });
+      assertCaptureLive();
+      if (
+        !approval ||
+        !approval.view.account ||
+        !sameWalletAccountId(approval.view.account, boundIntent.senderPublicKey) ||
+        approval.view.unlistedAssets !== 0 ||
+        approval.view.inputNotesConsumed !== 0 ||
+        approval.view.createdNotes?.some(note => note.opaque) ||
+        !approval.signing.approvedOutputNoteIds.includes(built.burnNoteId.toLowerCase())
+      ) {
+        throw new Error('USDCx burn effects could not be verified');
+      }
+      // The BURN id commits to its withdrawal/routing attachments; the resulting BURN may carry no asset.
+      const spends = netOutflowByFaucet({
+        ...approval.view,
+        outgoing: [...approval.view.outgoing, ...(approval.view.fee ? [approval.view.fee] : [])]
+      });
+      const record: ReviewedBurn = {
+        id,
+        intent: boundIntent,
+        destinationDomain,
+        ...built,
+        approval,
+        spends,
+        assertLive
+      };
+      const noteFlow = noteFlowFromSimulatedBytes(captured);
+      assertCaptureLive();
+      reviewed.set(account, record);
+      return {
+        id,
+        effects: toSimulatedEffectsWire(approval.view, noteFlow),
+        spends: spends.map(asset => ({ faucetId: asset.faucetId, amount: asset.amount.toString() }))
+      };
+    },
+    runsWasmInThisRealm() ? { watchdogMs: 30_000, label: 'usdcx-burn-review' } : { label: 'usdcx-burn-review' }
+  );
+}
+
+/** Resolves only the original backend-owned intent. Rechecked by the queue inside its atomic insert. */
+export function getReviewedUsdcxBurn(id: string | undefined, intent: UsdcxBurnIntent): ReviewedBurn {
+  const record = reviewed.get(canonicalWalletAccountId(intent.senderPublicKey));
+  if (
+    !record ||
+    record.id !== id ||
+    !sameWalletAccountId(record.intent.senderPublicKey, intent.senderPublicKey) ||
+    !sameWalletAccountId(record.intent.faucetId, intent.faucetId) ||
+    record.intent.amount !== intent.amount ||
+    record.intent.destinationAddress !== intent.destinationAddress ||
+    record.intent.destinationChainId !== intent.destinationChainId ||
+    record.destinationDomain !== getUsdcxDestination(intent.destinationChainId).domain
+  ) {
+    throw new Error('USDCx burn requires its original reviewed intent');
+  }
+  record.assertLive();
+  return record;
+}
