new file mode 100644
index 0000000000000000000000000000000000000000..327a36e84fc6ae3ed4483a6cb6188333dd90322d
--- /dev/null
+++ b/src/lib/usdcx/burn-request.ts
@@ -0,0 +1,130 @@
+import {
+  FeltArray,
+  FungibleAsset,
+  NetworkAccountTarget,
+  Note,
+  NoteArray,
+  NoteAssets,
+  NoteAttachment,
+  NoteAttachmentScheme,
+  NoteExecutionHint,
+  NoteMetadata,
+  NoteRecipient,
+  NoteScript,
+  NoteStorage,
+  NoteTag,
+  NoteType,
+  TransactionRequest,
+  TransactionRequestBuilder,
+  Word
+} from '@miden-sdk/miden-sdk/lazy';
+
+import type { ITransaction } from 'lib/miden/db/types';
+import { accountRefToSdk, randomFeeSalt, sameWalletAccountId } from 'lib/miden/sdk/helpers';
+import { withRpcTimeout } from 'lib/miden-chain/rpc-timeout';
+
+import {
+  USDCX_BURN_TAG,
+  USDCX_BURN_WITHDRAWAL_ATTACHMENT_SCHEME,
+  USDCX_MIN_BURN,
+  USDCX_MIN_BURN_SLOT,
+  getUsdcxDestination
+} from './constant';
+import { readWithOwnRpcClient } from './rpc-client';
+import { encodeBurnWithdrawal, requireUsdcxFaucetId, UsdcxBurnError } from './withdrawal';
+
+/**
+ * The minimum burn: the faucet's `min_burn_amount` when it is larger than `USDCX_MIN_BURN`, else `USDCX_MIN_BURN`.
+ * The read asks for an account proof, not the full account: the faucet's nonce map has grown past what the node
+ * serves through `getAccountDetails`. A failed read gives `USDCX_MIN_BURN`, so it never blocks a burn.
+ */
+export async function readUsdcxMinimumBurn(): Promise<bigint> {
+  try {
+    const proof = await withRpcTimeout(
+      () => readWithOwnRpcClient(rpc => rpc.getAccountProof(accountRefToSdk(requireUsdcxFaucetId()))),
+      'usdcx minimum burn'
+    );
+    const onChain = proof.getStorageSlotValue(USDCX_MIN_BURN_SLOT)?.toFelts()[0]?.asInt();
+    return onChain !== undefined && onChain > USDCX_MIN_BURN ? onChain : USDCX_MIN_BURN;
+  } catch (error) {
+    console.warn('USDCx minimum burn read failed, using the wallet minimum', error);
+    return USDCX_MIN_BURN;
+  }
+}
+
+function createUsdcxBurnNote(
+  sender: string,
+  amount: bigint,
+  destinationAddress: string,
+  destinationDomain: number,
+  serial?: Word
+): Note {
+  if (amount <= 0n) throw new UsdcxBurnError('usdcxInvalidAmount');
+  const asset = new FungibleAsset(accountRefToSdk(requireUsdcxFaucetId()), amount);
+  const storage = new NoteStorage(new FeltArray([...asset.vaultKey().toFelts(), ...asset.intoWord().toFelts()]));
+  const recipient =
+    serial === undefined
+      ? NoteRecipient.fromScript(NoteScript.burn(), storage)
+      : new NoteRecipient(serial, NoteScript.burn(), storage);
+  const metadata = new NoteMetadata(accountRefToSdk(sender), NoteType.Public, new NoteTag(USDCX_BURN_TAG));
+  const payload = encodeBurnWithdrawal(destinationAddress, destinationDomain);
+  const words = [0, 4, 8].map(i => new Word(new BigUint64Array(payload.slice(i, i + 4))));
+  const withdrawal = NoteAttachment.fromWords(new NoteAttachmentScheme(USDCX_BURN_WITHDRAWAL_ATTACHMENT_SCHEME), words);
+  // The factory routes with the `Always` hint; the note id commits to the attachment.
+  const routing = new NetworkAccountTarget(
+    accountRefToSdk(requireUsdcxFaucetId()),
+    NoteExecutionHint.always()
+  ).toAttachment();
+  return Note.withAttachments(new NoteAssets([asset]), metadata, recipient, [routing, withdrawal]);
+}
+
+/** Build a burn request from local SDK objects, following the `XReserveBurnNote` factory of miden-usdcx 0.17.1. */
+export function buildUsdcxBurnRequest(
+  sender: string,
+  amount: bigint,
+  destinationAddress: string,
+  destinationDomain: number
+) {
+  const note = createUsdcxBurnNote(sender, amount, destinationAddress, destinationDomain);
+  // NoteArray takes ownership. Capture identity before transferring the note.
+  const burnNoteId = note.id().toString();
+  const request = new TransactionRequestBuilder()
+    .withOwnOutputNotes(new NoteArray([note]))
+    .withFeeConversionSalt(randomFeeSalt())
+    .build();
+  return { burnNoteId, requestBytes: request.serialize() };
+}
+
+/** Reconstructs only the expected commitment, never a replacement BURN for submission. */
+export function assertUsdcxBurnRequest(transaction: ITransaction, requestBytes: Uint8Array): void {
+  const { amount, faucetId, extraInputs } = transaction;
+  const burn = extraInputs?.usdcxBurn;
+  const destination = extraInputs?.destinationAddress;
+  const chain = extraInputs?.destinationNetwork;
+  if (
+    amount === undefined ||
+    !faucetId ||
+    !sameWalletAccountId(faucetId, requireUsdcxFaucetId()) ||
+    !burn ||
+    !destination ||
+    chain === undefined ||
+    burn.destinationDomain !== getUsdcxDestination(chain).domain
+  ) {
+    throw new Error('The original BURN route differs from its intent');
+  }
+  const notes = TransactionRequest.deserialize(requestBytes).expectedOutputOwnNotes();
+  const note = notes[0];
+  if (notes.length !== 1 || !note || note.id().toString().toLowerCase() !== burn.noteId.toLowerCase()) {
+    throw new Error('The original BURN note is missing or substituted');
+  }
+  const expected = createUsdcxBurnNote(
+    transaction.accountId,
+    amount,
+    destination,
+    burn.destinationDomain,
+    note.recipient().serialNum()
+  );
+  if (expected.id().toString().toLowerCase() !== burn.noteId.toLowerCase()) {
+    throw new Error('The original BURN assets or withdrawal attachments differ from its intent');
+  }
+}
