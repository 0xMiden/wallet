+import { dryRunRequest } from './dry-run-request';
+import { assertWasmHoldCurrent, withWasmClientLock } from './miden-client';
+
+// The production alias otherwise finds the root manual mock, which has no ownership guard.
+jest.mock('lib/miden/sdk/miden-client', () => jest.requireActual('./miden-client'));
+jest.mock('./miden-client', () => jest.requireActual('./miden-client'));
+jest.mock('@miden-sdk/miden-sdk/lazy', () => ({ TransactionRequest: { deserialize: jest.fn() } }));
+jest.mock('lib/miden/sdk/custom-request', () => ({ prepareCustomRequestBytes: jest.fn() }));
+jest.mock('lib/miden/sdk/miden-client-interface', () => ({ MidenClientInterface: { create: jest.fn() } }));
+jest.mock('@openzeppelin/miden-multisig-client', () => ({
+  ...jest.requireActual('../../../../__mocks__/@openzeppelin/miden-multisig-client'),
+  executeForSummaryAtTip: jest.fn(),
+  requestBoundBlockNum: jest.fn()
+}));
+
+describe('dryRunRequest capture-and-refuse contract', () => {
+  const REQUEST = new Uint8Array([1, 2, 3]);
+  const PREPARED = new Uint8Array([4, 5, 6]);
+  const request = { blockNumbers: () => new Uint32Array([42]) };
+  const sdk: { TransactionRequest: { deserialize: jest.Mock } } = jest.requireMock('@miden-sdk/miden-sdk/lazy');
+  const preparation: { prepareCustomRequestBytes: jest.Mock } = jest.requireMock('lib/miden/sdk/custom-request');
+  const wrapper: { executeForSummaryAtTip: jest.Mock; requestBoundBlockNum: jest.Mock } =
+    jest.requireMock('@openzeppelin/miden-multisig-client');
+  const resultSerialize = jest.fn(() => new Uint8Array([9]));
+  const executeRequest = jest.fn(async () => ({ result: { serialize: resultSerialize } }));
+  const preview = jest.fn();
+  const sync = jest.fn();
+  const syncChain = jest.fn();
+  const importNote = jest.fn();
+  const prove = jest.fn();
+  const submit = jest.fn();
+  const apply = jest.fn();
+  const getSyncHeight = jest.fn(async () => 42);
+  const client = {
+    client: { transactions: { executeRequest, preview, prove, submit, apply }, getSyncHeight, sync, syncChain },
+    importNoteBytes: importNote
+  };
+
+  // Optional mode on an existing function; malformed modes deliberately cross the runtime boundary.
+  const run = (mode: unknown = 'capture-and-refuse') =>
+    withWasmClientLock(hold => Promise.resolve(Reflect.apply(dryRunRequest, undefined, [client, '0xaccount', REQUEST, hold, mode])));
+
+  beforeEach(() => {
+    const alias = jest.requireMock<typeof import('./miden-client')>('lib/miden/sdk/miden-client');
+    expect(alias.assertWasmHoldCurrent).toBe(assertWasmHoldCurrent);
+    expect(alias.withWasmClientLock).toBe(withWasmClientLock);
+    jest.clearAllMocks();
+    sdk.TransactionRequest.deserialize.mockReturnValue(request);
+    preparation.prepareCustomRequestBytes.mockResolvedValue(PREPARED);
+    wrapper.requestBoundBlockNum.mockReturnValue(undefined);
+    wrapper.executeForSummaryAtTip.mockResolvedValue({ serialize: () => new Uint8Array([0xab]) });
+    executeRequest.mockImplementation(async () => ({ result: { serialize: resultSerialize } }));
+    getSyncHeight.mockResolvedValue(42);
+  });
+
+  afterEach(() => {
+    expect(preview).not.toHaveBeenCalled();
+    expect(sync).not.toHaveBeenCalled();
+    expect(syncChain).not.toHaveBeenCalled();
+    expect(importNote).not.toHaveBeenCalled();
+    expect(prove).not.toHaveBeenCalled();
+    expect(submit).not.toHaveBeenCalled();
+    expect(apply).not.toHaveBeenCalled();
+  });
+
+  it('executes prepared bytes exactly once, without summary preview, and returns only the unexpected-success signal', async () => {
+    await expect(run()).resolves.toEqual({ executedBytes: Buffer.from([9]).toString('base64') });
+    expect(preparation.prepareCustomRequestBytes).toHaveBeenCalledWith(client.client, '0xaccount', REQUEST, expect.anything());
+    expect(sdk.TransactionRequest.deserialize).toHaveBeenCalledWith(PREPARED);
+    expect(executeRequest).toHaveBeenCalledTimes(1);
+    expect(executeRequest).toHaveBeenCalledWith('0xaccount', request);
+    expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    'TRANSACTION_ALREADY_AUTHORIZED: already fully authorized',
+    'already fully authorized',
+    'failed to generate signature',
+    'Failed to get secret key',
+    'no fee faucet is known',
+    'pass `feeFaucetId`',
+    'kernel assertion failed'
+  ])('propagates %s from the single execution without a message-triggered retry', async message => {
+    const failure = new Error(message);
+    executeRequest.mockRejectedValue(failure);
+    await expect(run()).rejects.toBe(failure);
+    expect(executeRequest).toHaveBeenCalledTimes(1);
+    expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+    expect(resultSerialize).not.toHaveBeenCalled();
+  });
+
+  it('preserves execution trap identity without retry', async () => {
+    const trap = new WebAssembly.RuntimeError('unreachable');
+    executeRequest.mockRejectedValue(trap);
+    await expect(run()).rejects.toBe(trap);
+    expect(executeRequest).toHaveBeenCalledTimes(1);
+    expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+  });
+
+  it('preparation failure executes nothing and remains the original failure', async () => {
+    const failure = new Error('auth preparation failed');
+    preparation.prepareCustomRequestBytes.mockRejectedValue(failure);
+    await expect(run()).rejects.toBe(failure);
+    expect(executeRequest).not.toHaveBeenCalled();
+    expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+  });
+
+  it.each([null, 7, {}, 'preview', ''])('refuses unrecognized present mode %p before preparation', async mode => {
+    await expect(run(mode)).rejects.toBeInstanceOf(Error);
+    expect(preparation.prepareCustomRequestBytes).not.toHaveBeenCalled();
+    expect(executeRequest).not.toHaveBeenCalled();
+    expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    { label: 'no bound', bound: undefined, declared: [], height: 0, executes: true },
+    { label: 'declared and ready', bound: 42, declared: [42], height: 42, executes: true },
+    { label: 'undeclared', bound: 42, declared: [41], height: 43, executes: false },
+    { label: 'declared but behind', bound: 42, declared: [42], height: 41, executes: false }
+  ])('$label bound block preserves no-sync prerequisites', async ({ bound, declared, height, executes }) => {
+    sdk.TransactionRequest.deserialize.mockReturnValue({ blockNumbers: () => new Uint32Array(declared) });
+    wrapper.requestBoundBlockNum.mockReturnValue(bound);
+    getSyncHeight.mockResolvedValue(height);
+    const denied = new Error('failed to generate signature');
+    executeRequest.mockRejectedValue(denied);
+    const outcome = run();
+    if (executes) {
+      await expect(outcome).rejects.toBe(denied);
+      expect(executeRequest).toHaveBeenCalledTimes(1);
+    } else {
+      await expect(outcome).rejects.toBeInstanceOf(Error);
+      expect(executeRequest).not.toHaveBeenCalled();
+    }
+    expect(wrapper.requestBoundBlockNum).toHaveBeenCalled();
+    expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+    if (bound !== undefined && declared.includes(bound)) expect(getSyncHeight).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(['preparation', 'height'])('reasserts the original hold after parking on %s', async parking => {
+    let finish: () => void = () => undefined;
+    const gate = new Promise<void>(resolve => { finish = resolve; });
+    if (parking === 'preparation') {
+      preparation.prepareCustomRequestBytes.mockImplementation(async () => { await gate; return PREPARED; });
+    } else {
+      wrapper.requestBoundBlockNum.mockReturnValue(42);
+      getSyncHeight.mockImplementation(async () => { await gate; return 42; });
+    }
+    const { withWasmClientLock: lock } = await import('./miden-client');
+    let abandoned: Promise<unknown> = Promise.resolve();
+    await lock(async hold => {
+      abandoned = Promise.resolve(Reflect.apply(dryRunRequest, undefined, [client, '0xaccount', REQUEST, hold, 'capture-and-refuse']))
+        .catch(error => error);
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    await lock(async hold => {
+      finish();
+      const outcome = await abandoned;
+      expect(outcome).toBeInstanceOf(Error);
+      expect(executeRequest).not.toHaveBeenCalled();
+      expect(wrapper.executeForSummaryAtTip).not.toHaveBeenCalled();
+      expect(hold).toBeDefined();
+    });
+  });
+});
