+class SetupError extends Error {
+  constructor(readonly stage: string) { super(stage); }
+}
+function requireSetup(ok: unknown, stage: string): asserts ok {
+  if (!ok) throw new SetupError(stage);
+}
+function object(value: unknown): Record<string, unknown> {
+  requireSetup(value !== null && typeof value === 'object' && !Array.isArray(value), 'wire');
+  return value as Record<string, unknown>;
+}
+function exactKeys(value: unknown, keys: readonly string[]): void {
+  requireSetup(same(Object.keys(object(value)).sort(), [...keys].sort()), 'wire');
+}
+function ids(value: unknown, length?: number): asserts value is string[] {
+  requireSetup(Array.isArray(value) && value.every(x => typeof x === 'string' && wordPattern.test(x)), 'wire');
