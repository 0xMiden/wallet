+mod capture;
+mod fixture;
+
+use std::path::Path;
+use std::process::ExitCode;
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() -> ExitCode {
+    std::panic::set_hook(Box::new(|_| eprintln!("O2_PANIC")));
+    let args = std::env::args_os().skip(1).collect::<Vec<_>>();
+    if args.len() != 2 || args[0] != "--out-dir" || args[1].is_empty() {
+        eprintln!("O2_USAGE");
+        return ExitCode::from(2);
+    }
+    match fixture::capture_pair(Path::new(&args[1])).await {
+        Ok(_) => ExitCode::SUCCESS,
+        Err(_) => {
+            eprintln!("O2_FIXTURE_FAILED");
+            ExitCode::from(3)
+        }
+    }
+}
