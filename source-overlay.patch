+it('passes one authentication for a bridged send creating its original note', async () => {
+  const sign = baseSigner();
+  const transaction = { ...prebuilt('bridged-send', 'original-note'), requestBytes: new Uint8Array([1]) };
+  givenSigning(
+    summaryInputs(
+      summary('acct-a', {
+        removed: [fa('fA', 500n), fa('usdcx', 2n)],
+        added: [],
+        inputs: [],
+        outputs: [note([fa('fA', 500n)], 'original-note'), feeNote(2n)]
+      })
+    )
+  );
+
+  await expect(withEffectCheckedSigner(transaction, sign, signer => signer('pk', 'aa'))).resolves.toBe(SIGNATURE);
+  expect(sign).toHaveBeenCalledTimes(1);
+});
+
+it('refuses a second valid authentication for one bridged send before delegation', async () => {
+  const sign = baseSigner();
+  const transaction = { ...prebuilt('bridged-send', 'original-note'), requestBytes: new Uint8Array([1]) };
+  givenSigning(
+    summaryInputs(
+      summary('acct-a', {
+        removed: [fa('fA', 500n), fa('usdcx', 2n)],
+        added: [],
+        inputs: [],
+        outputs: [note([fa('fA', 500n)], 'original-note'), feeNote(2n)]
+      })
+    )
+  );
+
+  let firstSignature: Uint8Array | undefined;
+  let firstSignCallCount: number | undefined;
+  const refused = await withEffectCheckedSigner(transaction, sign, async signer => {
+    firstSignature = await signer('pk', 'aa');
+    firstSignCallCount = sign.mock.calls.length;
+    return signer('pk', 'aa');
+  }).catch((error: unknown) => error);
+
+  expect(firstSignature).toBe(SIGNATURE);
+  expect(firstSignCallCount).toBe(1);
+  expect(sign).toHaveBeenCalledTimes(1);
+  expect(refused).toBeInstanceOf(ProposalEffectRefusedError);
+});
