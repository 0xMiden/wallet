--- /dev/null
+++ b/src/lib/agglayer/b2agg/confirm.ts
@@ -0,0 +1,32 @@
+import type { SpendingLimitAuthorization } from 'lib/miden/spending-limits/types';
+import { initiateBridgedSendTransaction } from 'lib/miden/transaction/initiate';
+import type { AgglayerBridgeIntent } from 'lib/shared/types';
+
+import { confirmAgglayerBridgeReview } from './review';
+
+export function confirmAgglayerBridge(
+  intent: AgglayerBridgeIntent,
+  reviewId: string,
+  authorization?: SpendingLimitAuthorization
+): Promise<string> {
+  return confirmAgglayerBridgeReview(reviewId, intent, review =>
+    initiateBridgedSendTransaction(
+      review.intent.senderPublicKey,
+      review.intent.amount,
+      review.intent.faucetId,
+      review.intent.destinationAddress,
+      review.route.evmNetworkId,
+      'agglayer',
+      review.requestBytes,
+      true,
+      undefined,
+      authorization,
+      review.exitTxHash,
+      undefined,
+      review.route.recovery,
+      undefined,
+      undefined,
+      { reviewId, intent }
+    )
+  );
+}
