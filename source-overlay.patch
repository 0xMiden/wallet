+    const makeRow = (): ITransaction => {
+      const approval = wallet.custom.approveCustomSimulation({
+        summaryBytes: Buffer.from(decoded[0].summary.serialize()).toString('base64'), introducedNoteIds: []
+      });
+      requireSetup(approval && approval.effects.shape === 'summary' && approval.effects.fee &&
+        approval.effects.fee.amount.toString() === fees[0], 'effects');
