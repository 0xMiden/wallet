+    destinationAddress: '0x1111',
+    destinationNetwork: 1,
+    claimStatus: 'not-applicable',
+    usdcxBurn: { noteId, destinationDomain: 26, phase: 'pending' }
+  }
+});
+const original = () => buildUsdcxBurnRequest('sender', 100n, '0x1111', 26);
+
+describe('original BURN prepared route binding (#2147)', () => {
+  it('validates the original serial/assets/routing/withdrawal commitment without changing the submitted request', () => {
+    const built = original();
+    const request = TransactionRequest.deserialize(built.requestBytes);
+    const before = request.expectedOutputOwnNotes()[0]?.id().toString();
+    expect(() => assertUsdcxBurnRequest(row(built.burnNoteId), built.requestBytes)).not.toThrow();
+    expect(before).toBe(built.burnNoteId);
+    expect(built.requestBytes).toEqual(new Uint8Array([1]));
+  });
+  it.each(['amount', 'sender', 'faucet', 'destination', 'domain', 'noteId'])(
+    'refuses changed %s despite a captured approval',
+    field => {
+      const built = original();
+      const changed = row(built.burnNoteId);
+      if (!changed.extraInputs?.usdcxBurn) throw new Error('missing fixture BURN');
+      switch (field) {
+        case 'amount':
+          changed.amount = 101n;
+          break;
+        case 'sender':
+          changed.accountId = 'other-sender';
+          break;
+        case 'faucet':
+          changed.faucetId = 'other-faucet';
+          break;
+        case 'destination':
+          changed.extraInputs.destinationAddress = '0x2222';
+          break;
+        case 'domain':
+          changed.extraInputs.usdcxBurn.destinationDomain = 9;
+          break;
+        case 'noteId':
+          changed.extraInputs.usdcxBurn.noteId = 'substituted';
+          break;
+      }
+      expect(() => assertUsdcxBurnRequest(changed, built.requestBytes)).toThrow();
+    }
+  );
+});
