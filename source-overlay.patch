+    validateMetadata(metadata);
+    const [s1, s2] = metadata.phases;
+    const bytes = [await readPrivate(dir, 's1.bin'), await readPrivate(dir, 's2.bin')];
+    stage = 'bindings';
+    const { bindings, digest } = await validateBindings();
+    result.sourceBindingsSha256 = digest;
+    const require = createRequire(import.meta.url);
+    const before = new Set(Object.keys(require.cache));
+    requireSetup(![...before].some(name => /[/\\]@miden-sdk[/\\]node-[^/\\]+[/\\].*\.node$/.test(name)), 'native');
+    stage = 'imports';
+    let nativeAsset = '';
+    jest.unstable_mockModule('lib/i18n/core', () => ({ getMessage: (key: string) => key }));
+    jest.unstable_mockModule('lib/miden-chain/native-asset', () => ({
+      getNativeAssetIdSync: () => nativeAsset,
+      getVerificationBaseFeeSync: () => 500,
+      refreshVerificationBaseFee: async () => 500,
+      isVerificationBaseFeeKnownAbsent: () => false,
