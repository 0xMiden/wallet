+async function writePrivateProbeResult(dir: string, validatedJson: string): Promise<void> {
+  requireSetup(dir.length > 0 && path.isAbsolute(dir), 'directory');
+  const directory = await lstat(dir);
+  requireSetup(directory.isDirectory() && !directory.isSymbolicLink() &&
+    directory.uid === process.getuid() && (directory.mode & 0o7777) === 0o700 &&
+    await realpath(dir) === dir, 'directory');
+  requireSetup(typeof validatedJson === 'string' && Buffer.byteLength(validatedJson, 'utf8') <= 4096 &&
+    proposedJson(JSON.parse(validatedJson)) === validatedJson, 'export');
+  const boundary = await lstat(dir);
+  requireSetup(boundary.isDirectory() && !boundary.isSymbolicLink() &&
+    boundary.uid === process.getuid() && (boundary.mode & 0o7777) === 0o700 &&
+    boundary.dev === directory.dev && boundary.ino === directory.ino && await realpath(dir) === dir, 'directory');
