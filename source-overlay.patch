+export function prepareAgglayerBridge(
+  req: PrepareAgglayerBridgeReviewRequest
+): Promise<PrepareAgglayerBridgeReviewResponse> {
+  return withUnlocked(async ({ vault }): Promise<PrepareAgglayerBridgeReviewResponse> => {
+    const intent = { ...req.intent, amount: parseSerializedSpendingAmount(req.intent.amount) };
+    const assertLive = () => {
+      const state = store.getState();
+      if (
+        state.vault !== vault ||
+        !state.accounts.some(account => sameWalletAccountId(account.publicKey, intent.senderPublicKey))
+      ) {
+        throw new Error('Agglayer account is no longer available');
+      }
+    };
+    assertLive();
+    return {
+      type: WalletMessageType.PrepareAgglayerBridgeReviewResponse,
+      ...(await prepareAgglayerBridgeReview(intent, assertLive, req.preparationId, vaultGuardianProvider))
+    };
+  });
+}
+export async function cancelAgglayerBridge(
+  req: CancelAgglayerBridgeReviewRequest
+): Promise<CancelAgglayerBridgeReviewResponse> {
+  cancelAgglayerBridgeReview(req.senderPublicKey, req.preparationId);
+  return { type: WalletMessageType.CancelAgglayerBridgeReviewResponse };
+}
+export function confirmAgglayerBridge(req: ConfirmAgglayerBridgeRequest): Promise<ConfirmAgglayerBridgeResponse> {
+  return withUnlocked(async (): Promise<ConfirmAgglayerBridgeResponse> => {
+    const authorization = req.spendingLimitAuthorization;
+    const transactionId = await enqueueAgglayerBridge(
+      { ...req.intent, amount: parseSerializedSpendingAmount(req.intent.amount) },
+      req.reviewId,
+      authorization?.kind === 'usd'
+        ? { ...authorization, usdAmount: parseSerializedSpendingAmount(authorization.usdAmount) }
+        : authorization
+    );
+    void startTransactionProcessing().catch(console.error);
+    return { type: WalletMessageType.ConfirmAgglayerBridgeResponse, transactionId };
+  });
+}
