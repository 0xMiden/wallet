+++ b/src/lib/miden/transaction/bridge-effects.ts
@@ -0,0 +1,79 @@
+import { netOutflowByFaucet, summaryBytesToView } from 'app/confirm/decode';
+import { assertAgglayerBridgeRequest } from 'lib/agglayer/b2agg/note';
+import { getMessage } from 'lib/i18n/core';
+import { midenClientProxy } from 'lib/miden/back/miden-client-proxy';
+import type { ITransaction } from 'lib/miden/db/types';
+import { prepareCustomRequestBytes } from 'lib/miden/sdk/custom-request';
+import { accountRefToSdk, sameWalletAccountId } from 'lib/miden/sdk/helpers';
+import { assertWasmHoldCurrent, getMidenClient, withWasmClientLock } from 'lib/miden/sdk/miden-client';
+import { spendsDigest } from 'lib/miden/spending-limits/types';
+import { cacheScope, isVerificationBaseFeeKnownAbsent, refreshVerificationBaseFee } from 'lib/miden-chain/native-asset';
+import { assertUsdcxBurnRequest } from 'lib/usdcx/burn-request';
+
+import { ProposalFeeUnknownError } from './constants';
+import { assertCustomEffectsApproved } from './custom-effects';
+import type { BridgeSigningAttempt } from './effect-checked-signer';
+import { assertCachedViewEffectApproved, effectRefusal } from './proposal-effect-guard';
+
+/** Checks the actual prepared execution, not a frontend declaration or a principal-only allowance. */
+export async function assertBridgeSummaryApproved(transaction: ITransaction, summaryBytes: string): Promise<void> {
+  await assertCachedViewEffectApproved(transaction, () => summaryBytesToView(summaryBytes));
+  const view = summaryBytesToView(summaryBytes);
+  if (!view.account || !sameWalletAccountId(view.account, transaction.accountId)) {
+    throw effectRefusal(transaction, 'the bridge summary belongs to another account');
+  }
+  assertCustomEffectsApproved(transaction.approvedEffects, { summaryBytes }, transaction.approvedOutflow);
+  const charged = [...(transaction.approvedOutflow ?? []), ...(view.fee ? [view.fee] : [])];
+  const chargedSpends = netOutflowByFaucet({ ...view, outgoing: charged });
+  if (spendsDigest(chargedSpends) !== spendsDigest(transaction.spentAssetTotals ?? [])) {
+    throw effectRefusal(transaction, 'the bridge costs differ from its admitted spends');
+  }
+}
+
+/** The request must still carry the original route note whose attachments and assets the backend approved. */
+export function assertBridgeRequestApproved(transaction: ITransaction, requestBytes: Uint8Array): void {
+  if (!transaction.approvedEffects) throw effectRefusal(transaction, 'the bridge has no backend executed approval');
+  if (transaction.extraInputs?.provider === 'usdcx') assertUsdcxBurnRequest(transaction, requestBytes);
+  if (transaction.extraInputs?.provider === 'agglayer') assertAgglayerBridgeRequest(transaction, requestBytes);
+}
+
+/** Strict capture stops at authentication; no fallback execution, proof, submission or client-state mutation. */
+export async function prepareBridgeSigningAttempt(
+  transaction: ITransaction
+): Promise<BridgeSigningAttempt & { requestBytes: Uint8Array }> {
+  const original = transaction.requestBytes;
+  if (!transaction.approvedEffects) throw effectRefusal(transaction, 'the bridge has no backend executed approval');
+  if (!original?.length) throw effectRefusal(transaction, 'the bridge has no approved prepared request');
+  const scope = cacheScope();
+  const fee = await refreshVerificationBaseFee();
+  if (fee === null && !isVerificationBaseFeeKnownAbsent()) {
+    throw new ProposalFeeUnknownError(getMessage('chainFeeUnknown'));
+  }
+  return withWasmClientLock(async hold => {
+    const assertLive = () => {
+      assertWasmHoldCurrent(hold, 'during bridge attempt capture');
+      if (cacheScope() !== scope) throw effectRefusal(transaction, 'the bridge network changed during preparation');
+    };
+    assertLive();
+    assertBridgeRequestApproved(transaction, original);
+    const client = await getMidenClient();
+    assertWasmHoldCurrent(hold, 'before bridge request preparation');
+    const requestBytes = await prepareCustomRequestBytes(client.client, transaction.accountId, original, hold);
+    assertWasmHoldCurrent(hold, 'after bridge request preparation');
+    assertBridgeRequestApproved(transaction, requestBytes);
+    const captured = await midenClientProxy.dryRunTransaction(
+      accountRefToSdk(transaction.accountId).toString(),
+      requestBytes,
+      hold,
+      { mode: 'capture-and-refuse', assertLive }
+    );
+    assertWasmHoldCurrent(hold, 'after bridge attempt capture');
+    if (!captured.signingInputsBytes || !captured.summaryBytes || captured.executedBytes) {
+      throw effectRefusal(transaction, 'the prepared bridge did not capture signing inputs');
+    }
+    await assertBridgeSummaryApproved(transaction, captured.summaryBytes);
+    assertWasmHoldCurrent(hold, 'after bridge attempt verification');
+    assertLive();
+    return { requestBytes, summaryBytes: captured.summaryBytes, scope };
+  });
+}
