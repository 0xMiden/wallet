+++ b/src/lib/agglayer/b2agg/review.ts
@@ -0,0 +1,330 @@
+import { nanoid } from 'nanoid';
+import { isAddress } from 'viem';
+
+import { netOutflowByFaucet } from 'app/confirm/decode';
+import { noteFlowFromSimulatedBytes } from 'app/confirm/note-flow';
+import { toSimulatedEffectsWire } from 'app/confirm/simulated-wire';
+import { isAgglayerFaucetAllowed } from 'lib/agglayer/allowed-faucets';
+import { midenClientProxy, runsWasmInThisRealm } from 'lib/miden/back/miden-client-proxy';
+import type { IConsumedAssetTotal } from 'lib/miden/db/types';
+import { isGuardianAccount, type GuardianAccountProvider } from 'lib/miden/front/guardian-manager';
+import { expirationDeltaBlocks } from 'lib/miden/helpers';
+import * as Repo from 'lib/miden/repo';
+import { accountRefToSdk, canonicalWalletAccountId, sameWalletAccountId } from 'lib/miden/sdk/helpers';
+import { assertWasmHoldCurrent, withWasmClientLock } from 'lib/miden/sdk/miden-client';
+import {
+  approveCustomSimulation,
+  customEffectsDifference,
+  type ApprovedCustomSimulation
+} from 'lib/miden/transaction/custom-effects';
+import { spendsDigest } from 'lib/miden/spending-limits/types';
+import { getEffectiveRpcUrl } from 'lib/miden-chain/effective-endpoints';
+import {
+  cacheScope,
+  getNativeAssetId,
+  isVerificationBaseFeeKnownAbsent,
+  refreshVerificationBaseFee
+} from 'lib/miden-chain/native-asset';
+import { featureAvailability } from 'lib/remote-config/availability';
+import { getBridgeConfigSnapshot, initBridgeConfig } from 'lib/remote-config/runtime';
+import { isNewTransferTokenHeld } from 'lib/remote-config/token-availability';
+import { getAgglayerBridgeOut } from 'lib/remote-config/values';
+import type { AgglayerBridgeIntent, AgglayerBridgeReview } from 'lib/shared/types';
+
+import { assertAgglayerCapturedOutputs, buildAgglayerBridgeRequest } from './request';
+
+export interface ReviewedAgglayerBridge {
+  id: string;
+  intent: Readonly<AgglayerBridgeIntent>;
+  route: ReturnType<typeof getAgglayerBridgeOut>;
+  noteId: string;
+  exitTxHash: string;
+  requestBytes: Uint8Array;
+  faucetBech32: string;
+  approval: ApprovedCustomSimulation;
+  spends: IConsumedAssetTotal[];
+  assertLive: () => void;
+}
+interface Preparation {
+  id: string;
+  intent: Readonly<AgglayerBridgeIntent>;
+  expiresAt: number;
+  assertSessionLive: () => void;
+  cancelled: boolean;
+  result?: Promise<AgglayerBridgeReview>;
+  record?: ReviewedAgglayerBridge;
+  confirming?: Promise<string>;
+  transactionId?: string;
+}
+const current = new Map<string, Preparation>();
+const preparations = new Map<string, Preparation>();
+const byId = new Map<string, Preparation>();
+const cancelled = new Map<string, number>();
+const keyOf = (sender: string, preparationId: string) => `${canonicalWalletAccountId(sender)}|${preparationId}`;
+const sameIntent = (left: AgglayerBridgeIntent, right: AgglayerBridgeIntent) =>
+  sameWalletAccountId(left.senderPublicKey, right.senderPublicKey) &&
+  sameWalletAccountId(left.faucetId, right.faucetId) &&
+  left.amount === right.amount &&
+  left.destinationAddress === right.destinationAddress &&
+  left.destinationChainId === right.destinationChainId;
+
+export function clearAgglayerBridgeReviews(): void {
+  current.clear();
+  preparations.clear();
+  byId.clear();
+  cancelled.clear();
+}
+export function cancelAgglayerBridgeReview(sender: string, preparationId: string): void {
+  const key = keyOf(sender, preparationId);
+  for (const [id, expiry] of cancelled) if (Date.now() >= expiry) cancelled.delete(id);
+  cancelled.set(key, Date.now() + 120_000);
+  const preparation = preparations.get(key);
+  if (!preparation || preparation.transactionId) return;
+  preparation.cancelled = true;
+  if (current.get(canonicalWalletAccountId(sender)) === preparation) current.delete(canonicalWalletAccountId(sender));
+}
+export function retireAgglayerBridgeReview(sender: string, id: string): void {
+  const preparation = byId.get(id);
+  if (!preparation || !sameWalletAccountId(preparation.intent.senderPublicKey, sender)) return;
+  preparation.transactionId = id;
+  if (current.get(canonicalWalletAccountId(sender)) === preparation) current.delete(canonicalWalletAccountId(sender));
+}
+
+export async function prepareAgglayerBridgeReview(
+  intent: AgglayerBridgeIntent,
+  assertSessionLive: () => void,
+  preparationId: string,
+  guardianProvider: GuardianAccountProvider
+): Promise<AgglayerBridgeReview> {
+  if (
+    !preparationId?.trim() ||
+    intent.amount <= 0n ||
+    intent.amount > 0xffffffffffffffffn ||
+    !Number.isSafeInteger(intent.destinationChainId) ||
+    intent.destinationChainId <= 0 ||
+    !isAddress(intent.destinationAddress)
+  ) {
+    throw new Error('Invalid Agglayer bridge intent');
+  }
+  const account = canonicalWalletAccountId(intent.senderPublicKey);
+  const key = keyOf(account, preparationId);
+  const previous = preparations.get(key);
+  if (previous) {
+    if (
+      !sameIntent(previous.intent, intent) ||
+      previous.cancelled ||
+      previous.transactionId ||
+      current.get(account) !== previous ||
+      Date.now() >= previous.expiresAt
+    ) {
+      throw new Error('Agglayer preparation is no longer current');
+    }
+    previous.assertSessionLive();
+    previous.record?.assertLive();
+    if (previous.result) return previous.result;
+  }
+  if ((cancelled.get(key) ?? 0) > Date.now()) throw new Error('Agglayer preparation was cancelled');
+  const scope = cacheScope();
+  const assertSessionCurrent = () => {
+    assertSessionLive();
+    if (cacheScope() !== scope) throw new Error('Agglayer bridge network is no longer current');
+  };
+  const preparation: Preparation = {
+    id: nanoid(),
+    intent: Object.freeze({ ...intent }),
+    expiresAt: Date.now() + 120_000,
+    cancelled: false,
+    assertSessionLive: assertSessionCurrent
+  };
+  const boundIntent = preparation.intent;
+  current.set(account, preparation);
+  preparations.set(key, preparation);
+  byId.set(preparation.id, preparation);
+  const assertLive = () => {
+    assertSessionCurrent();
+    if (
+      current.get(account) !== preparation ||
+      preparation.cancelled ||
+      cacheScope() !== scope ||
+      Date.now() >= preparation.expiresAt
+    ) {
+      throw new Error('Agglayer bridge review is no longer current');
+    }
+  };
+  preparation.result = (async () => {
+    assertLive();
+    await initBridgeConfig();
+    assertLive();
+    const nativeAsset = await getNativeAssetId();
+    assertLive();
+    const route = getAgglayerBridgeOut(boundIntent.destinationChainId);
+    const routeKey = JSON.stringify(route);
+    const assertConfigured = () => {
+      assertLive();
+      const snapshot = getBridgeConfigSnapshot();
+      if (
+        featureAvailability('bridgeOut', snapshot, undefined, boundIntent.destinationChainId).state !== 'available' ||
+        isNewTransferTokenHeld(snapshot, boundIntent.faucetId, nativeAsset) ||
+        JSON.stringify(getAgglayerBridgeOut(boundIntent.destinationChainId)) !== routeKey
+      ) {
+        throw new Error('Agglayer bridge configuration changed or is unavailable');
+      }
+    };
+    assertConfigured();
+    if (!(await isAgglayerFaucetAllowed(boundIntent.faucetId, getEffectiveRpcUrl(), boundIntent.destinationChainId))) {
+      throw new Error('Agglayer token is not supported');
+    }
+    assertConfigured();
+    const fee = await refreshVerificationBaseFee();
+    assertConfigured();
+    if (fee === null && !isVerificationBaseFeeKnownAbsent()) throw new Error('Agglayer fee is not known');
+    const expiration = expirationDeltaBlocks(await isGuardianAccount(boundIntent.senderPublicKey, guardianProvider));
+    assertConfigured();
+    return withWasmClientLock(
+      async hold => {
+        const assertCaptureLive = () => {
+          assertWasmHoldCurrent(hold, 'during Agglayer bridge capture');
+          assertConfigured();
+        };
+        assertCaptureLive();
+        const built = await buildAgglayerBridgeRequest(
+          preparation.intent,
+          route.midenBridge,
+          route.evmNetworkId,
+          expiration,
+          hold,
+          assertCaptureLive
+        );
+        assertCaptureLive();
+        const captured = await midenClientProxy.dryRunTransaction(
+          accountRefToSdk(boundIntent.senderPublicKey).toString(),
+          built.requestBytes,
+          hold,
+          { mode: 'capture-and-refuse', assertLive: assertCaptureLive }
+        );
+        assertCaptureLive();
+        if (!captured.signingInputsBytes || !captured.summaryBytes || captured.executedBytes)
+          throw new Error('Agglayer bridge did not capture signing inputs');
+        assertAgglayerCapturedOutputs(captured.summaryBytes, built.noteId, boundIntent.senderPublicKey, nativeAsset);
+        const approval = approveCustomSimulation({ summaryBytes: captured.summaryBytes, introducedNoteIds: [] });
+        assertCaptureLive();
+        const view = approval?.view;
+        const outputs = view?.createdNotes;
+        const exit = outputs?.find(note => note.id.toLowerCase() === built.noteId);
+        const principal = exit?.amounts[0];
+        if (
+          !approval ||
+          !view?.account ||
+          !sameWalletAccountId(view.account, boundIntent.senderPublicKey) ||
+          view.unlistedAssets !== 0 ||
+          view.inputNotesConsumed !== 0 ||
+          view.viewConsumedNotes?.length !== 0 ||
+          view.outgoingNfts.length !== 0 ||
+          view.incomingNfts.length !== 0 ||
+          view.incoming.length !== 0 ||
+          !outputs ||
+          outputs.length !== view.outputNotesCreated ||
+          outputs.some(note => note.opaque || note.nfts.length !== 0) ||
+          !exit ||
+          exit.amounts.length !== 1 ||
+          !principal ||
+          !sameWalletAccountId(principal.faucetId, boundIntent.faucetId) ||
+          principal.amount !== boundIntent.amount ||
+          !approval.signing.approvedOutputNoteIds.includes(built.noteId) ||
+          spendsDigest(netOutflowByFaucet({ ...view, outgoing: outputs.flatMap(note => note.amounts) })) !==
+            spendsDigest(approval.signing.approvedOutflow)
+        ) {
+          throw new Error('Agglayer bridge effects could not be verified');
+        }
+        const spends = netOutflowByFaucet({
+          ...view,
+          outgoing: [...approval.signing.approvedOutflow, ...(view.fee ? [view.fee] : [])]
+        });
+        const noteFlow = noteFlowFromSimulatedBytes(captured);
+        assertCaptureLive();
+        preparation.record = {
+          id: preparation.id,
+          intent: preparation.intent,
+          route,
+          ...built,
+          approval,
+          spends,
+          assertLive: assertConfigured
+        };
+        return {
+          id: preparation.id,
+          expiresAt: preparation.expiresAt,
+          effects: toSimulatedEffectsWire(view, noteFlow),
+          spends: spends.map(asset => ({ faucetId: asset.faucetId, amount: asset.amount.toString() }))
+        };
+      },
+      runsWasmInThisRealm()
+        ? { watchdogMs: 30_000, label: 'agglayer-bridge-review' }
+        : { label: 'agglayer-bridge-review' }
+    );
+  })();
+  return preparation.result;
+}
+
+export function getReviewedAgglayerBridge(
+  id: string | undefined,
+  intent: AgglayerBridgeIntent
+): ReviewedAgglayerBridge {
+  const preparation = id ? byId.get(id) : undefined;
+  if (!preparation?.record || preparation.transactionId || !sameIntent(preparation.intent, intent)) {
+    throw new Error('Agglayer requires its original reviewed intent');
+  }
+  preparation.record.assertLive();
+  return preparation.record;
+}
+
+export async function confirmAgglayerBridgeReview(
+  id: string,
+  intent: AgglayerBridgeIntent,
+  enqueue: (review: ReviewedAgglayerBridge) => Promise<string>
+): Promise<string> {
+  const preparation = byId.get(id);
+  if (!preparation || !sameIntent(preparation.intent, intent))
+    throw new Error('Agglayer requires its original reviewed intent');
+  preparation.assertSessionLive();
+  if (preparation.transactionId) {
+    const record = preparation.record;
+    const row = await Repo.transactions.get(preparation.transactionId);
+    preparation.assertSessionLive();
+    const saved = row?.extraInputs;
+    const expectedIds = record?.approval.effects.approvedOutputNoteIds ?? [];
+    const actualIds = row?.approvedEffects?.approvedOutputNoteIds ?? [];
+    if (
+      !record ||
+      !row ||
+      row.type !== 'bridged-send' ||
+      saved?.provider !== 'agglayer' ||
+      !sameWalletAccountId(row.accountId, record.intent.senderPublicKey) ||
+      !row.faucetId ||
+      !sameWalletAccountId(row.faucetId, record.intent.faucetId) ||
+      row.amount !== record.intent.amount ||
+      saved.destinationAddress !== record.intent.destinationAddress ||
+      saved.destinationNetwork !== record.route.evmNetworkId ||
+      saved.agglayerNoteId !== record.noteId ||
+      saved.agglayerExitTxHash !== record.exitTxHash ||
+      JSON.stringify(saved.agglayerRoute) !== JSON.stringify(record.route.recovery) ||
+      !row.approvedEffects ||
+      customEffectsDifference(record.approval.effects, row.approvedEffects) !== undefined ||
+      expectedIds.length !== actualIds.length ||
+      expectedIds.some(id => !actualIds.includes(id)) ||
+      spendsDigest(row.spentAssetTotals ?? []) !== spendsDigest(record.spends)
+    ) {
+      throw new Error('The queued Agglayer row differs from its original review');
+    }
+    return preparation.transactionId;
+  }
+  if (preparation.confirming) return preparation.confirming;
+  const record = getReviewedAgglayerBridge(id, intent);
+  const confirming = enqueue(record);
+  preparation.confirming = confirming;
+  try {
+    return await confirming;
+  } finally {
+    if (preparation.confirming === confirming) preparation.confirming = undefined;
+  }
+}
