+it('permits a bridged-send view creating its recorded original note', () => {
+  const transaction: ITransaction = {
+    ...new BridgedSendTransaction('bech32:acct', 100n, '0xevm', 0, 'agglayer', 'bech32:fA', REQUEST, true),
+    ...builtNote(BUILT)
+  };
+  const view = viewOf(
+    summary({
+      removed: [fa('fA', 100n), fa('usdcx', 2n)],
+      outputs: [note([fa('fA', 100n)], [], BUILT), feeNote(2n)]
+    })
+  );
