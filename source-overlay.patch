@@ -0,0 +1,91 @@
+import {
+  AccountId,
+  EthAddress,
+  FungibleAsset,
+  Note,
+  NoteAssets,
+  NoteRecipient,
+  NoteType,
+  TransactionRequest
+} from '@miden-sdk/miden-sdk/lazy';
+
+import type { ITransaction } from 'lib/miden/db/types';
+import { accountRefToSdk } from 'lib/miden/sdk/helpers';
+import { getAgglayerBridgeOut } from 'lib/remote-config/values';
+
+import { agglayerExitTxHash } from './exit-hash';
+
+export function createB2AggNote(
+  amount: bigint,
+  faucetId: string,
+  destinationAddress: string,
+  senderAddress: string,
+  midenBridge: string,
+  destinationNetwork: number
+) {
+  // Any asset bridges over AggLayer: the note carries the faucet of the token
+  // the user picked. Both ids go through `accountRefToSdk`, so the SDK always
+  // receives an `AccountId`: hex and bech32 are both accepted, and a composite
+  // wallet `publicKey` (`<address>_<suffix>`) has its suffix removed first.
+  // The asset-callback flag is intrinsic to the faucet's account id, so no
+  // per-asset flag is set here.
+  const asset = new FungibleAsset(accountRefToSdk(faucetId), amount);
+  return Note.createB2AggNote(
+    accountRefToSdk(senderAddress),
+    AccountId.fromHex(midenBridge),
+    new NoteAssets([asset]),
+    destinationNetwork,
+    EthAddress.fromHex(destinationAddress)
+  );
+}
+
+/** The exit hash alone does not prove that a note addresses the configured bridge or the intended EVM recipient. */
+export function assertAgglayerBridgeRequest(transaction: ITransaction, bytes: Uint8Array): void {
+  const { amount, faucetId, extraInputs } = transaction;
+  const saved = extraInputs?.agglayerRoute;
+  const destination = extraInputs?.destinationAddress;
+  if (!saved || !destination || amount === undefined || !faucetId) throw new Error('Agglayer route intent is missing');
+  const configured = getAgglayerBridgeOut(saved.chainId);
+  if (
+    extraInputs?.destinationNetwork !== configured.evmNetworkId ||
+    saved.midenBridgeId !== configured.midenBridge ||
+    saved.evmNetworkId !== configured.evmNetworkId ||
+    saved.contractAddress !== configured.recovery.contractAddress ||
+    saved.rollupId !== configured.recovery.rollupId ||
+    saved.indexerUrl !== configured.recovery.indexerUrl
+  )
+    throw new Error('Agglayer route differs from configuration');
+  const notes = TransactionRequest.deserialize(bytes).expectedOutputOwnNotes();
+  const actual = notes[0];
+  if (
+    notes.length !== 1 ||
+    !actual ||
+    !extraInputs?.agglayerNoteId ||
+    actual.id().toString().toLowerCase() !== extraInputs.agglayerNoteId.toLowerCase()
+  ) {
+    throw new Error('Agglayer requires its one original exit note');
+  }
+  const expected = createB2AggNote(
+    amount,
+    faucetId,
+    destination,
+    transaction.accountId,
+    configured.midenBridge,
+    configured.evmNetworkId
+  );
+  const recipient = new NoteRecipient(
+    actual.recipient().serialNum(),
+    expected.script(),
+    expected.recipient().storage()
+  );
+  const reconstructed = Note.withAttachments(expected.assets(), expected.metadata(), recipient, expected.attachments());
+  if (
+    actual.metadata().noteType() !== NoteType.Public ||
+    actual.metadata().sender().toString() !== expected.metadata().sender().toString() ||
+    actual.metadata().tag().asU32() !== expected.metadata().tag().asU32() ||
+    reconstructed.id().toString() !== actual.id().toString() ||
+    agglayerExitTxHash(actual) !== extraInputs?.agglayerExitTxHash
+  ) {
+    throw new Error('Agglayer exit assets or recipient differ from its authoritative intent');
+  }
+}
