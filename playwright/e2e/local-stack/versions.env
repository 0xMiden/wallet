# Exact pins for the local E2E stack. NEVER use floating tags.
#
# The 0.17 test node is built + run from miden-client's scripts/start-test-node.sh
# (it pins the node rev in its own Cargo.lock and handles genesis + validator
# storage-keys). The published ghcr node images still lag this line, so the node is
# compiled from source rather than pulled — there is no NODE_IMAGE_TAG here.
#
# Ref = the miden-client release web-sdk 0.17.0-rc.1 is built against (see NODE_SRC_REF below).
#
# The PROTOCOL layer under this node is NOT pinned here. When the PR carries a linked
# Protocol PR (wallet -> web-sdk -> protocol markers), .github/actions/run-local-node
# rebuilds the node, the remote prover and gen-genesis against that same rev, taken from
# the one place inject-linked-web-sdk-pr already resolved it. A second pin in this file
# would drift from the SDK's, and the skew is invisible until a guarded account fails on
# a fee procedure root the host has never seen.
NODE_SRC_REPO=https://github.com/0xMiden/rust-sdk.git
# rust-sdk tag v0.17.0-rc.1 (2fb20aca0): the release web-sdk 0.17.0-rc.1 is built against.
# Its Cargo.lock resolves miden-client 0.17.0-rc.1, protocol 0.17.0-rc.5, Miden VM 0.33,
# and the node crates at 0.17.0-rc.1. A 0.16 node rejects a 0.17 client at the accept
# header (and vice versa) by the pre-release-label rule.
NODE_SRC_REF=2fb20aca0869034dd26aa35473dbfb14fa017083

# note-transport-service: v0.5.0-rc.2 is the newest published release and the one whose
# proto crate (miden-note-transport-proto-build 0.5.0-rc.2) rust-sdk v0.17.0-rc.1 still
# resolves. Its own Cargo.toml still pins miden-protocol 0.16.0-rc.5; re-pin once an NTS
# release lands on the 0.17 line.
NOTE_TRANSPORT_REPO=https://github.com/0xMiden/note-transport-service
NOTE_TRANSPORT_REF=v0.5.0-rc.2

# miden-client-cli pin lives in package.json (midenClientCliGit.rev / midenClientCliVersion).
# CLI_PIN (informational, read from package.json):
#   version: 0.17.0-rc.1
#   git.url: https://github.com/0xMiden/rust-sdk
#   git.rev: 2fb20aca0869034dd26aa35473dbfb14fa017083  (= tag v0.17.0-rc.1, the same rev as NODE_SRC_REF)

# guardian (Tier-2): the guardian's own version line is independent of Miden's,
# so this tag does not track the SDK version. v0.17.0 is the first STABLE guardian
# release on the Miden 0.16 line: it pins miden-client 0.16.0, protocol/standards
# 0.16.1 and `@miden-sdk/miden-sdk` 0.16.0. There is no OpenZeppelin client for
# Miden protocol 0.17 yet, so guardian E2E against this SDK is expected red until
# that client exists. This tag must stay in lockstep with
# the @openzeppelin/miden-multisig-client version in package.json: server and
# client have to agree on the MASM procedure roots, and a mismatch surfaces at
# RUNTIME (install still succeeds, because the wallet's `resolutions` + the
# postinstall rimraf force the client onto the wallet's own SDK regardless).
#
# guardian-b (Tier-3, guardian-switch profile): reuses this SAME tag/pin — it's
# the same image, just a second instance with its own DB/keystore/ports (see
# docker-compose.local.yml). No separate GUARDIAN_B_IMAGE_TAG: keeping both
# guardians on one pin is intentional so a switch test can't accidentally
# exercise two different guardian-server versions.
GUARDIAN_IMAGE_TAG=v0.17.0
