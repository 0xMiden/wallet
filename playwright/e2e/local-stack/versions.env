# Exact pins for the local E2E stack. NEVER use floating tags.
#
# The 0.16 test node is built + run from miden-client's scripts/start-test-node.sh
# (it pins the node rev in its own Cargo.lock and handles genesis + validator
# storage-keys). The published ghcr node images still lag this line, so the node is
# compiled from source rather than pulled — there is no NODE_IMAGE_TAG here.
#
# Ref = the miden-client release web-sdk 0.16.0-rc.3 is built against: its Cargo.lock
# resolves miden-client 0.16.0-rc.2 (= tag v0.16.0-rc.2, 4872b090), with the protocol
# layer at 0.16.0-rc.6 and Miden VM at 0.29.1.
NODE_SRC_REPO=https://github.com/0xMiden/miden-client.git
NODE_SRC_REF=4872b090a3827474858f2ad30a395ca1af3b98c0

# note-transport-service: v0.5.0-rc.1 is the first release cut against the 0.16 rc
# line (its Cargo.toml pins miden-protocol 0.16.0-rc.5) and is still the newest one
# published. The SDK's protocol layer moved to 0.16.0-rc.6 with web-sdk 0.16.0-rc.3,
# so NTS now sits one prerelease BEHIND rather than one ahead — the gap is the same
# size, on the other side. Re-pin once an NTS release lands on exactly rc.6, or once
# both move to 0.16.0 final.
NOTE_TRANSPORT_REPO=https://github.com/0xMiden/note-transport-service
NOTE_TRANSPORT_REF=v0.5.0-rc.1

# miden-client-cli pin lives in package.json (midenClientCliGit.rev / midenClientCliVersion).
# CLI_PIN (informational, read from package.json):
#   version: 0.16.0-rc.2
#   git.url: https://github.com/0xMiden/miden-client
#   git.rev: 4872b090a3827474858f2ad30a395ca1af3b98c0

# guardian (Tier-2): KNOWN-INCOMPATIBLE on this branch, and not fixable here. The
# guardian's own version line is independent of Miden's: the newest published
# @openzeppelin/miden-multisig-client (0.16.2, 2026-08-12) still declares
# `@miden-sdk/miden-sdk: ^0.15.8`, i.e. every released guardian package is built
# against the Miden 0.15 protocol line. Nothing is published for 0.16 yet.
#
# The wallet's `resolutions` + the postinstall rimraf force the guardian client onto
# the wallet's own SDK, so install succeeds and the mismatch surfaces at RUNTIME as
# divergent MASM procedure roots. Guardian E2E is therefore expected red on this
# branch until guardian packages ship for 0.16 (#522) — recorded here rather than
# hidden behind a gate that cannot fail.
#
# guardian-b (Tier-3, guardian-switch profile): reuses this SAME tag/pin — it's
# the same image, just a second instance with its own DB/keystore/ports (see
# docker-compose.local.yml). No separate GUARDIAN_B_IMAGE_TAG: keeping both
# guardians on one pin is intentional so a switch test can't accidentally
# exercise two different guardian-server versions.
GUARDIAN_IMAGE_TAG=v0.16.0
