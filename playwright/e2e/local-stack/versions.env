# Exact pins for the local E2E stack. NEVER use floating tags.
# The node, validator, prover and note transport are built together from the
# Rust SDK's start-test-node.sh and its pinned node Cargo.lock.
NODE_SRC_REPO=https://github.com/0xMiden/rust-sdk.git
# rust-sdk v0.18.2: client 0.18.2, protocol 0.18.0, node 0.18.1.
NODE_SRC_REF=502b7b79fa87a486121b86e2101aafe5e05cd02d

# Linked Protocol PRs are resolved by inject-linked-web-sdk-pr; run-local-node
# rebuilds the node and prover against that same revision instead of a second pin.
# The standalone note-transport service is not used: run-note-transport.sh starts
# the node repository's miden-note-transport, built with the binaries above.

# The CLI's source and frozen released kernel are pinned in package.json and
# resolved by install-pinned-miden-cli.cjs, independently of the local node pin.

# Guardian 0.19.1 uses the Miden 0.18 protocol. Both npm clients and the metadata
# patch must match this tag (guardian-pins.test.ts). SDK deduplication alone does
# not establish procedure-root compatibility; lifecycle E2E qualifies the stack.
# Guardian B inherits this tag unless an explicit lifecycle dispatch overrides it.
GUARDIAN_IMAGE_TAG=v0.19.1
