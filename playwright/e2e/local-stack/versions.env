# Exact pins for the local E2E stack. NEVER use floating tags.
#
# NODE_IMAGE_TAG: confirmed present on ghcr.io/0xmiden/{miden-node,miden-validator,
#   miden-ntx-builder,miden-remote-prover} as of 2026-07-02.
NODE_IMAGE_TAG=v0.15.2

# note-transport-service: v0.4.1 is the latest release; its Cargo.toml pins
#   miden-protocol = "0.15" which matches node v0.15.0.
NOTE_TRANSPORT_REPO=https://github.com/0xMiden/note-transport-service
NOTE_TRANSPORT_REF=v0.4.1

# miden-client-cli pin lives in package.json (midenClientCliGit.rev / midenClientCliVersion).
# CLI_PIN (informational, read from package.json):
#   version: 0.15.0
#   git.url: https://github.com/0xMiden/miden-client
#   git.rev: 733720a7ce5886a390c848402b61079be1e6aa38

# guardian (Tier-2): only v0.15.0 is published on ghcr (else v0.14.8-rc.1). The
# wallet ships @openzeppelin/miden-multisig-client@0.15.0-rc.0; rc.0<->final MASM
# parity is the known compat gate (spec §8), verified by the guardian E2E on CI.
#
# guardian-b (Tier-3, guardian-switch profile): reuses this SAME tag/pin — it's
# the same image, just a second instance with its own DB/keystore/ports (see
# docker-compose.local.yml). No separate GUARDIAN_B_IMAGE_TAG: keeping both
# guardians on one pin is intentional so a switch test can't accidentally
# exercise two different guardian-server versions.
GUARDIAN_IMAGE_TAG=v0.16.0
