use miden::core::sys
use miden::standards::note
use miden::protocol::active_note
use miden::standards::fees::fee_manager
@account_procedure
pub proc compute_note_fee
    exec.note::get_recipient_preimage
    push.{CLAIM_ROOT} assert_eqw.err="unsupported funded claim root"
    push.2000 movdn.4 push.36 movdn.4
    exec.active_note::write_storage_to_memory
    mem_load.2029 eq.1 assert.err="claim ABI version"
    padw mem_loadw_le.2000 push.{P2ID_ROOT} assert_eqw.err="claim receipt root"
    mem_load.2012 eq.10000000 assert.err="claim allocation"
    dropw dropw dropw
    padw padw padw
    exec.fee_manager::read_fee_asset_id
    exec.sys::truncate_stack
end
