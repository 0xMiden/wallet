{
  "$schema": "https://unpkg.com/wrangler@4.151.3/config-schema.json",
  "name": "miden-wallet-feature-eligibility-topology-test",
  "main": "staging-topology-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "TOPOLOGY_BEARER": "synthetic-test-only-bearer",
    "TOPOLOGY_RUN_MAX": "7"
  },
  "ratelimits": [
    { "name": "TOPOLOGY_CALLER_RATE", "namespace_id": "189410", "simple": { "limit": 4, "period": 60 } },
    { "name": "TOPOLOGY_COLO_RATE", "namespace_id": "189411", "simple": { "limit": 4, "period": 10 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ELIGIBILITY_GUARD", "class_name": "EligibilityGuard" },
      { "name": "CALLER_GUARD", "class_name": "CallerEligibilityGuard" },
      { "name": "RESTART_PROOF", "class_name": "RestartProof" },
      { "name": "TOPOLOGY_CONTROL", "class_name": "TopologyControl" }
    ]
  },
  "migrations": [
    {
      "tag": "topology-v1",
      "new_sqlite_classes": ["EligibilityGuard", "CallerEligibilityGuard", "RestartProof", "TopologyControl"]
    }
  ]
}
