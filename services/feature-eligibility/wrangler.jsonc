{
  "$schema": "https://unpkg.com/wrangler@4.151.3/config-schema.json",
  "name": "miden-wallet-feature-eligibility",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "ALLOWED_ORIGINS": "[]",
    "MAXMIND_DAILY_QUERY_LIMIT": "0",
    "CALLER_REQUESTS_PER_MINUTE": "60",
    "DEPLOYMENT_REVISION": "unknown"
  },
  "durable_objects": {
    "bindings": [{ "name": "ELIGIBILITY_GUARD", "class_name": "EligibilityGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EligibilityGuard"] }]
}
