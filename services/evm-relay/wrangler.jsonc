{
  "$schema": "https://unpkg.com/wrangler@4.151.3/config-schema.json",
  "name": "miden-evm-relay",
  // worker.ts exports the fetch handler of index.ts and the Sender Durable Object class.
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  // Logs are on so the Worker can write one line when the relayer account has no funds.
  // Invocation logs are off, and the code never logs a request body.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Placeholders. The deploy workflow (deploy-evm-relay.yml) renders a release copy with the real values.
  // GAS_MODE is "sponsor" (the relayer pays the gas) or "deduct" (each batch pays its simulated gas cost, priced in a
  // fee token, to feeRecipient). RELAY_CONFIG is JSON: the one Calibur pin of all chains, the optional fee recipient,
  // and the optional `chains` object with the native price symbol, the fee tokens and the allowed targets of a chain.
  // The README gives its shape.
  // The pin is the Uniswap Calibur: the same address and the same runtime code hash on each chain that was checked
  // (Ethereum, Base, Arbitrum One, Polygon, Sepolia).
  "vars": {
    "ALLOWED_ORIGINS": "[]",
    "DEPLOYMENT_REVISION": "unknown",
    "GAS_MODE": "sponsor",
    "RELAY_CONFIG": "{\"calibur\":{\"address\":\"0x000000009b1d0af20d8c6d0a44e162d11f9b8f00\",\"runtimeHash\":\"0x7fa1bd2edb51499cb83a324acd9d0f35b31774cf8894e26fc13ac0474f4f57a4\",\"domainName\":\"Calibur\",\"domainVersion\":\"1.0.0\"}}"
  },
  // Secrets. Set them with `wrangler secret put`. Do not put them in vars.
  // RELAYER_PRIVATE_KEY: the key of the relayer account that executes the batches and pays the gas.
  // RPC_URL_<chainId>: the JSON-RPC URL of a chain, for example RPC_URL_8453. The Worker serves each chain that has
  // this secret, and no other chain.
  "ratelimits": [
    // Limits GET /v1/chains, GET /v1/account, POST /v1/quote and GET /v1/relay/{id} per caller IP, on the key
    // `read:<CF-Connecting-IP>`, and the account and quote routes per address, on the key `read-address:<address>`.
    // 189401 to 189404 are taken by the other Workers of the account.
    { "name": "READ_RATE_LIMIT", "namespace_id": "189405", "simple": { "limit": 60, "period": 60 } },
    // Limits POST /v1/relay per caller IP, on the key `relay:<CF-Connecting-IP>`, and per address, on the key
    // `relay-address:<evmAddress>`.
    { "name": "RELAY_RATE_LIMIT", "namespace_id": "189406", "simple": { "limit": 10, "period": 60 } }
  ],
  // The Sender: one Durable Object per chain (named by the chain id), with SQLite storage. It owns the relayer nonce.
  "durable_objects": {
    "bindings": [{ "name": "RELAY_SENDER", "class_name": "RelaySenderObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelaySenderObject"] }]
}
