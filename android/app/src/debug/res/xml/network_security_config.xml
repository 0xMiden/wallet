<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network policy.

  This file overlays the production `src/main/res/xml/network_security_config.xml`
  for debug builds only (Gradle resource merging prefers the build-variant source
  set), so the release AAB that ships to Play keeps the tight production policy:
  cleartext for the Miden note transport and nothing else.

  The dApp-browser E2E suite serves pages from the host at 10.0.2.2 over HTTP.
  Auth Tab acceptance also uses HTTPS with a run-scoped CA installed in the
  disposable emulator. User CAs are trusted only for that fixture host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">transport.miden.io</domain>
    </domain-config>
    <!-- The acceptance CA is user-installed for this host in a disposable emulator. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
