<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network policy.

  This file overlays the production `src/main/res/xml/network_security_config.xml`
  for debug builds only (Gradle resource merging prefers the build-variant source
  set), so the release AAB that ships to Play keeps the tight production policy:
  cleartext for the Miden note transport and nothing else.

  Why debug needs more: the dApp-browser E2E suite serves its fixture dApps from
  a local HTTP server on the host, which the emulator reaches at 10.0.2.2. The
  production config would have the WebView refuse those loads, and the suite
  would be testing an error page instead of the dApp browser. Serving the
  fixtures over HTTPS instead would mean shipping a trusted test CA into the
  app — strictly worse than permitting cleartext to loopback in debug builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">transport.miden.io</domain>
    </domain-config>
    <!-- Host loopback as seen from the emulator, plus the emulator's own. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
