          "enum": [
            "setup",
            "recovery_gate",
            "wallet_session",
            "quote_request",
            "quote_availability",
            "quote",
            "preparation",
            "approval",
            "execution",
            "proof",
            "submission",
            "inclusion",
            "order",
            "payback",
            "claim",
            "usable_receipt",
