        "evidence": {"enum": ["observed", "not_recorded", "not_applicable"]},
        "reason": {"enum": [null, "not_instrumented", "not_reached", "not_applicable", "report_incomplete"]},
        "startAt": {"$ref": "#/$defs/startAt"},
        "endAt": {"$ref": "#/$defs/endAt"},
        "elapsedMs": {"$ref": "#/$defs/elapsedMs"},
        "timeoutMs": {"$ref": "#/$defs/timeoutMs"},
        "deadlineAt": {"$ref": "#/$defs/deadlineAt"},
        "error": {"$ref": "#/$defs/error"},
