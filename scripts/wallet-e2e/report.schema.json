          ]
        },
        "recoveryEffect": {
          "enum": [
            "no_work",
            "read_only",
            "prior_authorized_claim",
            "prior_authorized_return",
            "not_applicable",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "unknown",
            "not_started",
            "prepared",
            "executed",
            "authorization_released",
            "included",
            "partial_fill",
            "fully_filled",
            "payment_unclaimed",
            "claimed",
            "usable_receipt",
            "refunded",
            "partially_filled_and_refunded",
            "full_swap_asserted",
            "bridge_completion_asserted"
