{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xMiden/wallet/contracts/wallet-e2e/v1",
  "title": "Safe wallet nightly job report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producerVersion",
    "generatedAt",
    "units",
    "clockPolicy",
    "synthetic",
    "fixture",
    "network",
    "testEnvironment",
    "availability",
    "repository",
    "workflowId",
    "workflowPath",
    "sourceSha",
    "sourceRef",
    "event",
    "runId",
    "runNumber",
    "runAttempt",
    "jobKey",
    "jobId",
    "startAt",
    "endAt",
    "elapsedMs",
    "timeoutMs",
    "build",
    "coverage",
    "stages",
    "invocations"
  ],
  "properties": {
    "schemaVersion": {"const": "wallet-e2e/v1"},
    "producerVersion": {"const": "1.0.0"},
    "generatedAt": {"$ref": "#/$defs/timestamp"},
    "units": {"const": "milliseconds"},
    "clockPolicy": {"const": "utc_observation_and_monotonic_elapsed"},
    "synthetic": {"const": true},
    "fixture": {"type": "boolean"},
    "network": {"const": "mainnet"},
    "testEnvironment": {"const": "chrome_extension"},
    "availability": {"enum": ["available", "partial"]},
    "repository": {"const": "0xMiden/wallet"},
    "workflowId": {"const": "391951744"},
    "workflowPath": {"const": ".github/workflows/e2e-mainnet-nightly.yml"},
    "sourceSha": {"$ref": "#/$defs/sha"},
    "sourceRef": {"const": "refs/heads/main"},
    "event": {"enum": ["schedule", "workflow_dispatch"]},
    "runId": {"$ref": "#/$defs/id"},
    "runNumber": {"$ref": "#/$defs/id"},
    "runAttempt": {"$ref": "#/$defs/id"},
    "jobKey": {"enum": ["mainnet", "agglayer"]},
    "jobId": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"$ref": "#/$defs/id"}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"const": null}, "reason": {"enum": ["github_metadata_only", "not_observed"]}}
        }
      ]
    },
    "startAt": {"$ref": "#/$defs/startAt"},
    "endAt": {"$ref": "#/$defs/endAt"},
    "elapsedMs": {"$ref": "#/$defs/elapsedMs"},
    "timeoutMs": {"$ref": "#/$defs/timeoutMs"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensionVersion", "extensionSha256", "sdkVersion", "remoteConfigSha256", "endpointLabels"],
      "properties": {
        "extensionVersion": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$", "maxLength": 27},
                "reason": {"const": null}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {"const": null},
                "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
              }
            }
          ]
        },
        "extensionSha256": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {"value": {"$ref": "#/$defs/sha256"}, "reason": {"const": null}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {"const": null},
                "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
              }
            }
          ]
        },
        "sdkVersion": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(-[a-z]{1,8}[.-][0-9]{1,4})?$",
                  "maxLength": 32
                },
                "reason": {"const": null}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {"const": null},
                "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
              }
            }
          ]
        },
        "remoteConfigSha256": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {"value": {"$ref": "#/$defs/sha256"}, "reason": {"const": null}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {"const": null},
                "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
              }
            }
          ]
        },
        "endpointLabels": {
          "type": "array",
          "items": {
            "enum": [
              "miden_mainnet_rpc",
              "miden_mainnet_guardian",
              "inicio_mainnet",
              "epoch_mainnet",
              "near_mainnet",
              "agglayer_mainnet"
            ]
          },
          "maxItems": 8
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swap", "bridge", "freshSwapsStarted"],
      "properties": {
        "swap": {"$ref": "#/$defs/coverage"},
        "bridge": {"$ref": "#/$defs/coverage"},
        "freshSwapsStarted": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 17}, "reason": {"const": null}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {
                "value": {"const": null},
                "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
              }
            }
          ]
        }
      }
    },
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}, "maxItems": 32},
    "invocations": {"type": "array", "items": {"$ref": "#/$defs/invocation"}, "maxItems": 17}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$", "maxLength": 20},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$", "maxLength": 40},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "maxLength": 64},
    "testId": {"type": "string", "pattern": "^[a-f0-9]{24}$", "maxLength": 24},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$",
      "maxLength": 24
    },
    "status": {
      "enum": ["passed", "failed", "timed_out", "skipped", "interrupted", "not_started", "in_progress", "unknown"]
    },
    "duration": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "elapsedMs": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"$ref": "#/$defs/duration"}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"const": null},
            "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
          }
        }
      ]
    },
    "startAt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"$ref": "#/$defs/timestamp"}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"const": null},
            "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
          }
        }
      ]
    },
    "endAt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"$ref": "#/$defs/timestamp"}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"const": null},
            "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
          }
        }
      ]
    },
    "timeoutMs": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"$ref": "#/$defs/duration"}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"const": null},
            "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
          }
        }
      ]
    },
    "deadlineAt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"$ref": "#/$defs/timestamp"}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"const": null},
            "reason": {"enum": ["not_observed", "not_applicable", "not_available", "report_incomplete"]}
          }
        }
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 255}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"const": null}, "reason": {"enum": ["not_observed", "report_incomplete"]}}
        }
      ]
    },
    "playwrightOutcome": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {"value": {"enum": ["passed", "failed", "timed_out", "interrupted"]}, "reason": {"const": null}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reason"],
          "properties": {
            "value": {"const": null},
            "reason": {"enum": ["not_observed", "not_applicable", "report_incomplete"]}
          }
        }
      ]
    },
    "spec": {
      "enum": [
        "mainnet-swap-loop.spec.ts",
        "mainnet-epoch-loop.spec.ts",
        "mainnet-1click-loop.spec.ts",
        "mainnet-round-trip.spec.ts",
        "mainnet-bridge-loop.spec.ts",
        "mainnet-agglayer-loop.spec.ts"
      ]
    },
    "operationKind": {"enum": ["swap", "bridge", "setup", "recovery", "other"]},
    "surface": {"enum": ["wallet_ui", "helper_sdk", "wallet_ui_and_helper", "unknown"]},
    "opKey": {
      "enum": [
        "swap-forward",
        "swap-reverse",
        "swap-recovery",
        "epoch-forward",
        "epoch-reverse",
        "epoch-recovery",
        "near-forward",
        "near-reverse",
        "near-recovery",
        "usdcx-ethereum",
        "usdcx-base",
        "usdcx-arc",
        "usdcx-arbitrum",
        "agglayer-deposit",
        "agglayer-withdrawal",
        "native-round-trip",
        "registration"
      ]
    },
    "mode": {"enum": ["authorize_recovery_return", "recover", "prepare", "forward", "reverse", "round_trip"]},
    "invocationId": {
      "enum": [
        "swap-recovery-grant",
        "swap-recover",
        "swap-recovered-return",
        "epoch-recover",
        "near-recover",
        "swap-prepare",
        "swap-forward",
        "swap-reverse",
        "epoch-prepare",
        "epoch-forward",
        "epoch-reverse",
        "near-prepare",
        "near-forward",
        "near-reverse",
        "native-round-trip",
        "usdcx-round-trip",
        "agglayer-round-trip"
      ]
    },
    "tokenSymbol": {
      "enum": [
        "MIDEN",
        "USDC",
        "USDCx",
        "PAXG",
        "ETH",
        "BTC",
        "WBTC",
        "WETH",
        "WMATIC",
        "POL",
        "MATIC",
        "USDT",
        "SOL",
        "NEAR"
      ]
    },
    "networkLabel": {
      "enum": [
        "Miden",
        "Ethereum",
        "Base",
        "Arc",
        "Polygon",
        "Bitcoin",
        "Arbitrum",
        "Solana",
        "Monad",
        "BNB",
        "Near",
        "OP Mainnet"
      ]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "baseUnits", "decimals"],
      "properties": {
        "asset": {"$ref": "#/$defs/tokenSymbol"},
        "baseUnits": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,29})$", "maxLength": 30},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 24}
      }
    },
    "error": {
      "anyOf": [
        {"const": null},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_price_stale"},
            "explanation": {"const": "The quoted price was older than the accepted freshness limit."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_price_clock_skew"},
            "explanation": {"const": "The quoted price timestamp was too far ahead of the wallet clock."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_settlement_paused"},
            "explanation": {"const": "The solver reported that settlement was paused."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_liquidity_insufficient"},
            "explanation": {"const": "The solver reported insufficient liquidity for the requested swap."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_price_out_of_band"},
            "explanation": {"const": "The quoted price was outside the accepted range."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "recovery_checkpoint_account_mismatch"},
            "explanation": {"const": "The recovery checkpoint did not match the wallet account."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "recovery_approval_missing"},
            "explanation": {"const": "The approval required for recovery was missing."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "recovery_gate_failed"},
            "explanation": {"const": "Prior swap recovery did not clear the gate. The underlying cause is unavailable."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "test_failed"},
            "explanation": {"const": "Playwright observed a test failure. A more specific stage may be available."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "test_timed_out"},
            "explanation": {"const": "Playwright reported that this test exceeded its timeout."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "command_failed"},
            "explanation": {"const": "The test command exited with a nonzero status."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "setup_failed"},
            "explanation": {"const": "An observed setup step failed before test execution."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_unavailable"},
            "explanation": {"const": "The solver did not provide a usable quote."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_request_failed"},
            "explanation": {"const": "The quote request did not complete successfully."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "quote_failed"},
            "explanation": {
              "const": "The wallet did not obtain a usable quote. Request and availability evidence are incomplete."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "preparation_failed"},
            "explanation": {"const": "The wallet did not finish transaction preparation."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "execution_failed"},
            "explanation": {"const": "The observed wallet execution step failed."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "submission_failed"},
            "explanation": {"const": "The submission step did not confirm submission."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "inclusion_unconfirmed"},
            "explanation": {"const": "The submitted transaction did not reach the asserted inclusion state."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "order_outcome_unconfirmed"},
            "explanation": {"const": "The wallet did not establish a final order outcome."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "claim_unconfirmed"},
            "explanation": {"const": "The wallet did not establish the asserted claim result."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "receipt_unconfirmed"},
            "explanation": {"const": "The wallet did not establish the asserted usable receipt."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "input_refunded"},
            "explanation": {"const": "The wallet recovered refunded input and failed the full-completion assertion."}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {"const": "bridge_failed"},
            "explanation": {"const": "The observed bridge step failed before the required assertion completed."}
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "status",
        "origin",
        "evidence",
        "reason",
        "startAt",
        "endAt",
        "elapsedMs",
        "timeoutMs",
        "deadlineAt",
        "error",
        "httpStatus",
        "priceAgeMs",
        "endpoint"
      ],
      "properties": {
