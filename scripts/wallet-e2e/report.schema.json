      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "surface",
        "sourceRunId",
        "recoveryEffect",
        "outcome",
        "provider",
        "sourceNetwork",
        "destinationNetwork",
        "offered",
        "minimum",
        "received",
        "fee",
        "stages"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/opKey"},
        "kind": {"$ref": "#/$defs/operationKind"},
        "surface": {"$ref": "#/$defs/surface"},
        "sourceRunId": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {"value": {"$ref": "#/$defs/id"}, "reason": {"const": null}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "reason"],
              "properties": {"value": {"const": null}, "reason": {"enum": ["not_observed", "not_applicable"]}}
