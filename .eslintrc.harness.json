{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-unfalsifiable-balance-assertion": "error",
    "no-long-bare-wait": "error",
    "no-conditional-expect": "error"
  }
}
