# Transak partner API key and secret (Transak dashboard > Developers).
# The secret stays on this server. Never put it in the wallet bundle.
TRANSAK_API_KEY=
TRANSAK_API_SECRET=

# staging | production. This selects the Transak hosts. Default: staging.
TRANSAK_ENV=staging

# The referrer that Transak approved for this partner account. A native app sends its
# bundle ID (iOS) or package name (Android), not a web domain. Default: com.miden.bread.
TRANSAK_REFERRER_DOMAIN=com.miden.bread

# HTTP port. Default: 8787.
PORT=8787

# Comma-separated list of origins that can call this server.
# Empty: all origins ('*').
ALLOWED_ORIGINS=

# Maximum buy amount in USD. Default: 10000.
MAX_FIAT_AMOUNT_USD=10000

# Required. The key of the Sepolia account that pays gas for the relayed bridge batch (0x + 64 hex).
# Fund it with Sepolia ETH. Never use a key that holds real funds.
RELAYER_PRIVATE_KEY=

# Ethereum Sepolia JSON-RPC. Default: https://ethereum-sepolia-rpc.publicnode.com.
SEPOLIA_RPC_URL=

# The ERC-20 that Transak delivers on Sepolia. Default: TRNSK (Transak staging), 18 decimals.
ONRAMP_TOKEN_ADDRESS=0x0c86a754a29714c4fe9c6f1359fa7099ed174c0b
ONRAMP_TOKEN_DECIMALS=18

# SQLite file of the orders. Default: ./data/onramp.sqlite.
DB_PATH=./data/onramp.sqlite

# Time between two worker ticks, in milliseconds. Default: 10000.
WORKER_INTERVAL_MS=10000

# The Pusher app of the Transak order feed (public, from the Transak WebSocket docs).
# Defaults: 1d9ffac87de599c61283 and ap2.
TRANSAK_PUSHER_KEY=
TRANSAK_PUSHER_CLUSTER=

# Minimum time between two Transak Get Orders calls for one order when no feed event comes,
# in milliseconds. A feed event makes the call at once. Default: 60000. Minimum: 10000.
TRANSAK_POLL_INTERVAL_MS=60000
